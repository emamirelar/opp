<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    
    <!-- Suppress nullability warnings that require extensive refactoring -->
    <!-- These warnings indicate potential null reference issues but are non-blocking -->
    <!-- They should be addressed incrementally as part of regular development -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605</NoWarn>
    <NoWarn>$(NoWarn);CS8613;CS8618;CS8619;CS8620;CS8621;CS8625;CS8629</NoWarn>
    <NoWarn>$(NoWarn);CS8714;CS8765;CS8766;CS8767</NoWarn>
    
    <!-- Suppress warnings for intentional patterns -->
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0414;CS0649</NoWarn> <!-- Unused variables/fields - often in legacy code -->
    <NoWarn>$(NoWarn);CS0219</NoWarn> <!-- Variable assigned but not used -->
    <NoWarn>$(NoWarn);CS0162</NoWarn> <!-- Unreachable code - often in debug/feature flags -->
    <NoWarn>$(NoWarn);CS0472</NoWarn> <!-- Comparison always true/false -->
    <NoWarn>$(NoWarn);CS0693</NoWarn> <!-- Type parameter same name as outer type -->
    <NoWarn>$(NoWarn);CS0659</NoWarn> <!-- Overrides Equals but not GetHashCode -->
    <NoWarn>$(NoWarn);CS1570</NoWarn> <!-- XML comment malformed -->
    <NoWarn>$(NoWarn);CS1571</NoWarn> <!-- XML comment has duplicate param tag -->
    <NoWarn>$(NoWarn);CS1572</NoWarn> <!-- XML comment has parameter that doesn't match actual parameter -->
    <NoWarn>$(NoWarn);CS1573</NoWarn> <!-- Parameter has no matching param tag in XML comment -->
    <NoWarn>$(NoWarn);CS1587</NoWarn> <!-- XML comment not placed on valid language element -->
    <NoWarn>$(NoWarn);CS1717</NoWarn> <!-- Assignment to same variable -->
    <NoWarn>$(NoWarn);CS1998</NoWarn> <!-- Async method lacks await -->
    
    <!-- Suppress obsolete API warnings for Google APIs (require major refactoring) -->
    <NoWarn>$(NoWarn);CS0618</NoWarn> <!-- Obsolete member usage -->
    
    <!-- Suppress Entity Framework analyzer warnings -->
    <NoWarn>$(NoWarn);EF1002</NoWarn> <!-- SQL injection warning for ExecuteSqlRaw -->
    
    <!-- Suppress ASP.NET analyzer warnings -->
    <NoWarn>$(NoWarn);ASP0019</NoWarn> <!-- IHeaderDictionary.Add usage -->
  </PropertyGroup>
</Project>

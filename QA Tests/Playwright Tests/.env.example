# Playwright Test Environment Configuration
# Copy this file to .env and update with your actual test credentials

# Test User Credentials
TEST_USER_EMAIL=testuser@unops.org
TEST_USER_PASSWORD=TestPassword123!

# Base URLs
BASE_URL=http://localhost:4200
API_BASE_URL=http://localhost:5000

# Test Timeouts (milliseconds)
DEFAULT_TIMEOUT=10000
LONG_TIMEOUT=30000
SHORT_TIMEOUT=5000

# Browser Settings
HEADLESS=false
SLOW_MO=0

# Test Data
TEST_PARTNER_NAME=Test Partner Organization
TEST_CONTACT_NAME=Test Contact Name
TEST_OPPORTUNITY_NAME=Test Opportunity

# Debug Settings
DEBUG=false
TRACE_ON_FAILURE=true
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

# ============================================================================
# oUP (oneUNOPS Projects) Integration Testing
# Required for oup-integration.spec.ts tests
# See QA-014 in Defect List for QA.md
# ============================================================================

# oUP Test Environment
OUP_BASE_URL=https://projects-test.unops.org
OUP_API_URL=https://projects-test.unops.org/api
OUP_USERNAME=your-oup-test-username
OUP_PASSWORD=your-oup-test-password

# Test User Emails (for notification testing)
OPP_MANAGER_EMAIL=test.oppmanager@unops.org
DOA2_EMAIL=test.doa2@unops.org
BD_EMAIL=test.bd@unops.org

# Email Inbox Access (for notification verification)
EMAIL_HOST=imap.unops.org
EMAIL_USERNAME=qa-test-inbox@unops.org
EMAIL_PASSWORD=your-email-password
EMAIL_PORT=993
EMAIL_TLS=true

# Google Cloud Pub/Sub Monitoring (optional)
PUBSUB_PROJECT_ID=your-gcp-project-id
PUBSUB_SUBSCRIPTION_NAME=opportunity-sync-subscription

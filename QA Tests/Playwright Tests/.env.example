# Playwright Test Environment Configuration
# Copy this file to .env and update with your actual test credentials

# Test User Credentials
TEST_USER_EMAIL=testuser@unops.org
TEST_USER_PASSWORD=TestPassword123!

# Base URLs
BASE_URL=http://localhost:4200
API_BASE_URL=http://localhost:5000

# Test Timeouts (milliseconds)
DEFAULT_TIMEOUT=10000
LONG_TIMEOUT=30000
SHORT_TIMEOUT=5000

# Browser Settings
HEADLESS=false
SLOW_MO=0

# Test Data
TEST_PARTNER_NAME=Test Partner Organization
TEST_CONTACT_NAME=Test Contact Name
TEST_OPPORTUNITY_NAME=Test Opportunity

# Debug Settings
DEBUG=false
TRACE_ON_FAILURE=true
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

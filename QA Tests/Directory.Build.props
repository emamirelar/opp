<Project>
  <!-- Import parent Directory.Build.props if it exists -->
  <PropertyGroup>
    <ParentBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</ParentBuildProps>
  </PropertyGroup>
  <Import Project="$(ParentBuildProps)" Condition="'$(ParentBuildProps)' != '' and Exists('$(ParentBuildProps)')" />

  <PropertyGroup>
    <!-- Ensure test results are always created under QA Tests folder -->
    <VSTestResultsDirectory>$(MSBuildThisFileDirectory)TestResults</VSTestResultsDirectory>
    <TestResultsDirectory>$(MSBuildThisFileDirectory)TestResults</TestResultsDirectory>
  </PropertyGroup>
</Project>

        /// <summary>
        /// Test exact maximum length for Name field (boundary value analysis)
        /// </summary>
        [Fact]
        public async Task Create_NameAtMaxLength_Succeeds()
        {
            // Arrange
            var maxLength = 500; // Adjust to actual max length
            var name = new string('A', maxLength);
            var request = new Create[ENTITY]Request { Name = name };
            
            // Act
            var result = await _manager.CreateAsync(request);
            
            // Assert
            result.Should().NotBeNull();
            result.Name.Should().HaveLength(maxLength);
        }

        /// <summary>
        /// Test one character over maximum length (boundary + 1)
        /// </summary>
        [Fact]
        public async Task Create_NameExceedsMaxLength_ThrowsValidationException()
        {
            // Arrange
            var maxLength = 500;
            var name = new string('A', maxLength + 1);
            var request = new Create[ENTITY]Request { Name = name };
            
            // Act
            var act = () => _manager.CreateAsync(request);
            
            // Assert
            await act.Should().ThrowAsync<ValidationException>();
        }


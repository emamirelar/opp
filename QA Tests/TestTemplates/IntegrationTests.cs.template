    public class [ENTITY]IntegrationTests : IClassFixture<PAOWebApplicationFactory>
    {
        private readonly HttpClient _client;
        private readonly PAOWebApplicationFactory _factory;

        public [ENTITY]IntegrationTests(PAOWebApplicationFactory factory)
        {
            _factory = factory;
            _client = factory.CreateClient(new WebApplicationFactoryClientOptions
            {
                AllowAutoRedirect = false
            });
            _client.DefaultRequestHeaders.Add("dev-user-email", "test@playwright.local");
        }

        #region Complete CRUD Workflow

        /// <summary>
        /// Complete CRUD workflow: Create → Read → Update → Delete
        /// </summary>
        [Fact]
        public async Task CRUD_CompleteWorkflow_SucceedsEndToEnd()
        {
            // CREATE
            var createRequest = new
            {
                Name = $"Integration Test Entity {DateTime.UtcNow:yyyyMMddHHmmss}",
                Description = "Created via integration test"
            };

            var createResponse = await _client.PostAsJsonAsync("/api/[entity]", createRequest);
            createResponse.StatusCode.Should().Be(HttpStatusCode.Created);

            var createdEntity = await createResponse.Content.ReadFromJsonAsync<[ENTITY]Model>();
            createdEntity.Should().NotBeNull();
            var entityId = createdEntity!.Id;

            // READ
            var getResponse = await _client.GetAsync($"/api/[entity]/{entityId}");
            getResponse.StatusCode.Should().Be(HttpStatusCode.OK);

            var fetchedEntity = await getResponse.Content.ReadFromJsonAsync<[ENTITY]Model>();
            fetchedEntity.Should().NotBeNull();
            fetchedEntity!.Name.Should().Be(createRequest.Name);

            // UPDATE
            var updateRequest = new
            {
                Id = entityId,
                Name = "Updated Name",
                Description = "Updated via integration test"
            };

            var updateResponse = await _client.PutAsJsonAsync($"/api/[entity]/{entityId}", updateRequest);
            updateResponse.StatusCode.Should().Be(HttpStatusCode.OK);

            // Verify update
            var verifyResponse = await _client.GetAsync($"/api/[entity]/{entityId}");
            var updatedEntity = await verifyResponse.Content.ReadFromJsonAsync<[ENTITY]Model>();
            updatedEntity!.Name.Should().Be("Updated Name");

            // DELETE
            var deleteResponse = await _client.DeleteAsync($"/api/[entity]/{entityId}");
            deleteResponse.StatusCode.Should().Be(HttpStatusCode.NoContent);

            // Verify deletion
            var verifyDeleteResponse = await _client.GetAsync($"/api/[entity]/{entityId}");
            verifyDeleteResponse.StatusCode.Should().Be(HttpStatusCode.NotFound);
        }

        #endregion

        #region API Contract Verification

        /// <summary>
        /// GET endpoint returns expected JSON structure
        /// </summary>
        [Fact]
        public async Task GetById_ReturnsExpectedJsonStructure()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();

            // Act
            var response = await _client.GetAsync($"/api/[entity]/{entity.Id}");

            // Assert
            response.StatusCode.Should().Be(HttpStatusCode.OK);
            response.Content.Headers.ContentType?.MediaType.Should().Be("application/json");

            var json = await response.Content.ReadAsStringAsync();
            json.Should().Contain("\"id\":");
            json.Should().Contain("\"name\":");
            json.Should().Contain("\"createdDate\":");
        }

        /// <summary>
        /// GetAll returns paginated response
        /// </summary>
        [Fact]
        public async Task GetAll_ReturnsPaginatedResponse()
        {
            // Arrange - Create multiple entities
            for (int i = 0; i < 15; i++)
            {
                await CreateTestEntityAsync($"Pagination Test {i}");
            }

            // Act
            var response = await _client.GetAsync("/api/[entity]?pageSize=10&pageIndex=0");

            // Assert
            response.StatusCode.Should().Be(HttpStatusCode.OK);

            var result = await response.Content.ReadFromJsonAsync<PaginatedResponse<[ENTITY]Model>>();
            result.Should().NotBeNull();
            result!.Items.Should().HaveCount(10);
            result.TotalCount.Should().BeGreaterThanOrEqualTo(15);
            result.PageSize.Should().Be(10);
        }

        #endregion

        #region Cross-Cutting Concerns

        /// <summary>
        /// Request includes audit headers
        /// </summary>
        [Fact]
        public async Task Create_PopulatesAuditFields()
        {
            // Act
            var entity = await CreateTestEntityAsync();

            // Assert
            entity.CreatedDate.Should().BeCloseTo(DateTime.UtcNow, TimeSpan.FromMinutes(1));
            entity.CreatedBy.Should().BeGreaterThan(0);
        }

        /// <summary>
        /// Unauthorized request returns 401
        /// </summary>
        [Fact]
        public async Task GetAll_NoAuthHeader_ReturnsUnauthorized()
        {
            // Arrange - Create client without auth header
            var unauthClient = _factory.CreateClient();
            unauthClient.DefaultRequestHeaders.Clear();

            // Act
            var response = await unauthClient.GetAsync("/api/[entity]");

            // Assert
            response.StatusCode.Should().Be(HttpStatusCode.Unauthorized);
        }

        /// <summary>
        /// Invalid request returns proper error response
        /// </summary>
        [Fact]
        public async Task Create_InvalidRequest_ReturnsBadRequest()
        {
            // Arrange - Missing required field
            var invalidRequest = new
            {
                // Name is missing
                Description = "No name provided"
            };

            // Act
            var response = await _client.PostAsJsonAsync("/api/[entity]", invalidRequest);

            // Assert
            response.StatusCode.Should().Be(HttpStatusCode.BadRequest);

            var problemDetails = await response.Content.ReadFromJsonAsync<ProblemDetails>();
            problemDetails.Should().NotBeNull();
        }

        #endregion

        #region Related Entity Operations

        /// <summary>
        /// Creating entity with related entities establishes relationships
        /// </summary>
        [Fact]
        public async Task Create_WithRelatedEntities_EstablishesRelationships()
        {
            // Arrange
            var relatedEntity = await CreateRelatedEntityAsync();
            var request = new
            {
                Name = "Entity with Relationship",
                RelatedEntityId = relatedEntity.Id
            };

            // Act
            var response = await _client.PostAsJsonAsync("/api/[entity]", request);
            var entity = await response.Content.ReadFromJsonAsync<[ENTITY]Model>();

            // Assert
            entity!.RelatedEntityId.Should().Be(relatedEntity.Id);

            // Verify relationship via navigation
            var detailResponse = await _client.GetAsync($"/api/[entity]/{entity.Id}?includeRelated=true");
            var detail = await detailResponse.Content.ReadFromJsonAsync<[ENTITY]DetailModel>();
            detail!.RelatedEntity.Should().NotBeNull();
        }

        /// <summary>
        /// Deleting entity cascades to related entities appropriately
        /// </summary>
        [Fact]
        public async Task Delete_CascadesToRelatedEntities()
        {
            // Arrange
            var entity = await CreateEntityWithChildrenAsync();
            var childIds = entity.Children.Select(c => c.Id).ToList();

            // Act
            var deleteResponse = await _client.DeleteAsync($"/api/[entity]/{entity.Id}");
            deleteResponse.StatusCode.Should().Be(HttpStatusCode.NoContent);

            // Assert - Children should be soft-deleted or orphaned based on rules
            foreach (var childId in childIds)
            {
                var childResponse = await _client.GetAsync($"/api/child-entity/{childId}");
                // Adjust assertion based on cascade behavior
            }
        }

        #endregion

        #region Search and Filtering

        /// <summary>
        /// Search by name returns matching results
        /// </summary>
        [Fact]
        public async Task GetAll_SearchByName_ReturnsMatchingResults()
        {
            // Arrange
            var uniqueName = $"UniqueSearchTerm_{Guid.NewGuid():N}";
            await CreateTestEntityAsync(uniqueName);

            // Act
            var response = await _client.GetAsync($"/api/[entity]?search={uniqueName}");

            // Assert
            response.StatusCode.Should().Be(HttpStatusCode.OK);

            var result = await response.Content.ReadFromJsonAsync<PaginatedResponse<[ENTITY]Model>>();
            result!.Items.Should().ContainSingle(e => e.Name.Contains(uniqueName));
        }

        /// <summary>
        /// Filter by status returns correct results
        /// </summary>
        [Fact]
        public async Task GetAll_FilterByStatus_ReturnsFilteredResults()
        {
            // Act
            var response = await _client.GetAsync("/api/[entity]?status=Active");

            // Assert
            response.StatusCode.Should().Be(HttpStatusCode.OK);

            var result = await response.Content.ReadFromJsonAsync<PaginatedResponse<[ENTITY]Model>>();
            result!.Items.Should().OnlyContain(e => e.Status == "Active");
        }

        #endregion

        #region Transaction Integrity

        /// <summary>
        /// Partial failure rolls back entire transaction
        /// </summary>
        [Fact]
        public async Task BulkCreate_PartialFailure_RollsBackAll()
        {
            // Arrange
            var requests = new[]
            {
                new { Name = "Valid Entity 1" },
                new { Name = "Valid Entity 2" },
                new { Name = "" },  // Invalid - will fail
                new { Name = "Valid Entity 3" }
            };

            var countBefore = await GetEntityCountAsync();

            // Act
            var response = await _client.PostAsJsonAsync("/api/[entity]/bulk", requests);

            // Assert
            response.StatusCode.Should().Be(HttpStatusCode.BadRequest);

            var countAfter = await GetEntityCountAsync();
            countAfter.Should().Be(countBefore); // No entities created
        }

        #endregion

        #region Helper Methods

        private async Task<[ENTITY]Model> CreateTestEntityAsync(string? name = null)
        {
            var request = new
            {
                Name = name ?? $"Test Entity {Guid.NewGuid():N}"[..30]
            };

            var response = await _client.PostAsJsonAsync("/api/[entity]", request);
            response.EnsureSuccessStatusCode();

            return await response.Content.ReadFromJsonAsync<[ENTITY]Model>()
                ?? throw new Exception("Failed to create test entity");
        }

        private async Task<RelatedEntityModel> CreateRelatedEntityAsync()
        {
            var request = new { Name = "Related Entity" };
            var response = await _client.PostAsJsonAsync("/api/related-entity", request);
            response.EnsureSuccessStatusCode();
            return await response.Content.ReadFromJsonAsync<RelatedEntityModel>()
                ?? throw new Exception("Failed to create related entity");
        }

        private async Task<[ENTITY]Model> CreateEntityWithChildrenAsync()
        {
            var parent = await CreateTestEntityAsync("Parent Entity");
            // Add children
            return parent;
        }

        private async Task<int> GetEntityCountAsync()
        {
            var response = await _client.GetAsync("/api/[entity]?pageSize=1");
            var result = await response.Content.ReadFromJsonAsync<PaginatedResponse<[ENTITY]Model>>();
            return result?.TotalCount ?? 0;
        }

        #endregion
    }
}

        #region OWASP A08:2021 - Software & Data Integrity Failures

        /// <summary>
        /// Data modification should be audited
        /// </summary>
        [Fact]
        public async Task Update_ShouldCreateAuditLog()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            var originalName = entity.Name;

            // Act
            await _manager.UpdateAsync(new Update[ENTITY]Request
            {
                Id = entity.Id,
                Name = "Modified Name"
            });

            // Assert
            var auditLog = await Context.AuditLogs
                .Where(a => a.EntityId == entity.Id && a.EntityType == "[ENTITY]")
                .OrderByDescending(a => a.CreatedDate)
                .FirstAsync();
            
            auditLog.Should().NotBeNull();
            auditLog.Action.Should().Be("Update");
            auditLog.Changes.Should().Contain("Name");
        }

        #endregion

        #region OWASP A09:2021 - Security Logging & Monitoring

        /// <summary>
        /// Failed access attempts should be logged
        /// </summary>
        [Fact]
        public async Task GetById_UnauthorizedAccess_Logged()
        {
            // Arrange
            var entity = await CreateEntityAsOtherUserAsync();

            // Act
            try { await _manager.GetByIdAsync(entity.Id); }
            catch (UnauthorizedAccessException) { }

            // Assert
            var securityLog = await Context.SecurityLogs
                .Where(l => l.EventType == "UnauthorizedAccess")
                .OrderByDescending(l => l.Timestamp)
                .FirstOrDefaultAsync();
            
            securityLog.Should().NotBeNull();
        }

        #endregion

        #region OWASP A10:2021 - Server-Side Request Forgery (SSRF)

        /// <summary>
        /// Internal network URLs should be blocked
        /// </summary>
        [Theory]
        [InlineData("http://localhost/admin")]
        [InlineData("http://127.0.0.1/api")]
        [InlineData("http://192.168.1.1/internal")]
        [InlineData("file:///etc/passwd")]
        public async Task Create_SsrfAttempt_Blocked(string maliciousUrl)
        {
            // Arrange
            var request = new Create[ENTITY]Request
            {
                Name = "Test",
                ExternalUrl = maliciousUrl
            };

            // Act
            var act = () => _manager.CreateAsync(request);

            // Assert
            await act.Should().ThrowAsync<ValidationException>()
                .WithMessage("*not allowed*");
        }


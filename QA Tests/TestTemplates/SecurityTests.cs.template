        #region Data Protection

        /// <summary>
        /// PII should be masked in logs
        /// </summary>
        [Fact]
        public async Task Logging_PiiData_Masked()
        {
            // Arrange
            var request = new Create[ENTITY]Request
            {
                Name = "John Doe",
                Email = "john.doe@example.com",
                Phone = "+1-555-123-4567"
            };

            // Act
            await _manager.CreateAsync(request);

            // Assert - Check logs don't contain raw PII
            var logs = await GetRecentLogsAsync();
            logs.Should().NotContain("john.doe@example.com");
            logs.Should().NotContain("+1-555-123-4567");
        }

        /// <summary>
        /// Deleted data should be truly removed (GDPR compliance)
        /// </summary>
        [Fact]
        public async Task HardDelete_PiiData_CompletelyRemoved()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            var entityId = entity.Id;

            // Act
            await _manager.HardDeleteAsync(entityId); // GDPR erasure

            // Assert
            var deletedEntity = await Context.[ENTITY]s
                .IgnoreQueryFilters()
                .FirstOrDefaultAsync(e => e.Id == entityId);
            
            deletedEntity.Should().BeNull();
        }


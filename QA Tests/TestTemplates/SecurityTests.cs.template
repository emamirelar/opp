        #region OWASP A01:2021 - Broken Access Control

        /// <summary>
        /// User without permission should not access entity
        /// </summary>
        [Fact]
        public async Task GetById_UserWithoutReadPermission_ThrowsUnauthorizedException()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            SetCurrentUserWithoutPermissions();

            // Act
            var act = () => _manager.GetByIdAsync(entity.Id);

            // Assert
            await act.Should().ThrowAsync<UnauthorizedAccessException>();
        }

        /// <summary>
        /// User should not access entity from different organization
        /// </summary>
        [Fact]
        public async Task GetById_EntityFromDifferentOrg_ThrowsUnauthorizedException()
        {
            // Arrange
            var entity = await CreateEntityInDifferentOrgAsync();
            SetCurrentUserInTestOrg();

            // Act
            var act = () => _manager.GetByIdAsync(entity.Id);

            // Assert
            await act.Should().ThrowAsync<UnauthorizedAccessException>();
        }

        /// <summary>
        /// IDOR: User should not update entity they don't own
        /// </summary>
        [Fact]
        public async Task Update_EntityOwnedByAnotherUser_ThrowsUnauthorizedException()
        {
            // Arrange
            var entity = await CreateEntityAsOtherUserAsync();
            var request = new Update[ENTITY]Request { Id = entity.Id, Name = "Hacked!" };

            // Act
            var act = () => _manager.UpdateAsync(request);

            // Assert
            await act.Should().ThrowAsync<UnauthorizedAccessException>();
        }

        /// <summary>
        /// IDOR: User should not delete entity they don't own
        /// </summary>
        [Fact]
        public async Task Delete_EntityOwnedByAnotherUser_ThrowsUnauthorizedException()
        {
            // Arrange
            var entity = await CreateEntityAsOtherUserAsync();

            // Act
            var act = () => _manager.DeleteAsync(entity.Id);

            // Assert
            await act.Should().ThrowAsync<UnauthorizedAccessException>();
        }

        /// <summary>
        /// Privilege escalation: Regular user cannot perform admin actions
        /// </summary>
        [Fact]
        public async Task AdminAction_ByRegularUser_ThrowsUnauthorizedException()
        {
            // Arrange
            SetCurrentUserAsRegularUser();

            // Act
            var act = () => _manager.PerformAdminActionAsync();

            // Assert
            await act.Should().ThrowAsync<UnauthorizedAccessException>();
        }


        #region OWASP A02:2021 - Cryptographic Failures

        /// <summary>
        /// Sensitive data should be encrypted at rest
        /// </summary>
        [Fact]
        public async Task Create_SensitiveData_EncryptedInDatabase()
        {
            // Arrange
            var sensitiveValue = "SENSITIVE-DATA-12345";
            var request = new Create[ENTITY]Request
            {
                Name = "Test",
                SensitiveField = sensitiveValue
            };

            // Act
            var result = await _manager.CreateAsync(request);

            // Assert - Check raw database value is encrypted
            var rawValue = await Context.Database
                .SqlQueryRaw<string>($"SELECT SensitiveField FROM [ENTITY]s WHERE Id = {result.Id}")
                .FirstAsync();
            rawValue.Should().NotBe(sensitiveValue); // Should be encrypted
        }

        #endregion

        #region OWASP A03:2021 - Injection

        /// <summary>
        /// SQL Injection in search field should be prevented
        /// </summary>
        [Theory]
        [InlineData("'; DROP TABLE [ENTITY]s; --")]
        [InlineData("1' OR '1'='1")]
        [InlineData("admin'--")]
        [InlineData("' UNION SELECT password FROM Users --")]
        public async Task Search_SqlInjectionAttempt_Prevented(string maliciousSearch)
        {
            // Arrange - Create some legitimate data
            await CreateTestEntityAsync("Legitimate Entity");

            // Act
            var results = await _manager.GetAllAsync(searchText: maliciousSearch);

            // Assert - Should not expose all data or cause errors
            results.Should().BeEmpty(); // No matching entities
            // Database should remain intact - verify tables exist
            var tableCount = await Context.[ENTITY]s.CountAsync();
            tableCount.Should().BeGreaterThan(0);
        }

        /// <summary>
        /// Command injection in file operations should be prevented
        /// </summary>
        [Theory]
        [InlineData("file.txt; rm -rf /")]
        [InlineData("file.txt | cat /etc/passwd")]
        [InlineData("file.txt && dir")]
        public async Task Upload_CommandInjectionAttempt_Prevented(string maliciousFilename)
        {
            // Arrange
            var request = new Upload[ENTITY]DocumentRequest
            {
                EntityId = 1,
                FileName = maliciousFilename
            };

            // Act
            var act = () => _manager.UploadDocumentAsync(request);

            // Assert
            await act.Should().ThrowAsync<ValidationException>();
        }

        /// <summary>
        /// LDAP injection should be prevented
        /// </summary>
        [Theory]
        [InlineData("*)(objectClass=*)")]
        [InlineData("admin)(&(password=*))")]
        public async Task Search_LdapInjectionAttempt_Prevented(string maliciousInput)
        {
            // Test LDAP injection prevention if applicable
        }


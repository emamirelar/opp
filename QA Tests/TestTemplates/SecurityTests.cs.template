        #region OWASP A04:2021 - Insecure Design

        /// <summary>
        /// Rate limiting should prevent abuse
        /// </summary>
        [Fact]
        public async Task Create_ExceedingRateLimit_ThrowsTooManyRequestsException()
        {
            // Arrange - Make many rapid requests
            var tasks = Enumerable.Range(1, 1000)
                .Select(i => CreateTestEntityAsync($"Entity {i}"));

            // Act
            var act = () => Task.WhenAll(tasks);

            // Assert
            await act.Should().ThrowAsync<TooManyRequestsException>();
        }

        /// <summary>
        /// Business logic bypass should be prevented
        /// </summary>
        [Fact]
        public async Task UpdateStatus_BypassingRequiredApproval_ThrowsBusinessException()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            // Try to skip approval workflow

            // Act
            var act = () => _manager.UpdateStatusAsync(entity.Id, EntityStatus.Approved);

            // Assert
            await act.Should().ThrowAsync<BusinessException>()
                .WithMessage("*approval required*");
        }

        #endregion

        #region OWASP A05:2021 - Security Misconfiguration

        /// <summary>
        /// Debug information should not be exposed in production
        /// </summary>
        [Fact]
        public async Task Error_ShouldNotExposeStackTrace()
        {
            // Arrange - Cause an error
            var act = () => _manager.GetByIdAsync(999999);

            // Act & Assert
            var exception = await act.Should().ThrowAsync<KeyNotFoundException>();
            exception.Which.Message.Should().NotContain("at UNOPS.PAO");
            exception.Which.StackTrace.Should().BeNullOrEmpty();
        }

        /// <summary>
        /// Default credentials should not work

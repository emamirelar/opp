        /// <summary>
        /// Weak password should be rejected
        /// </summary>
        [Theory]
        [InlineData("password")]
        [InlineData("12345678")]
        [InlineData("qwerty")]
        [InlineData("abc")]
        public void PasswordValidation_WeakPassword_Rejected(string weakPassword)
        {
            // Arrange
            var validator = new PasswordValidator();

            // Act
            var result = validator.Validate(weakPassword);

            // Assert
            result.IsValid.Should().BeFalse();
        }


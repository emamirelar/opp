        [Fact]
        public void DefaultCredentials_ShouldNotBeValid()
        {
            // Verify no hardcoded credentials
            var config = GetConfiguration();
            config["DefaultAdminPassword"].Should().BeNull();
            config["TestPassword"].Should().BeNull();
        }


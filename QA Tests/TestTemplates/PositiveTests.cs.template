        }

        /// <summary>
        /// Create with all optional fields populated should succeed
        /// </summary>
        [Fact]
        public async Task Create_AllFieldsPopulated_ReturnsCompleteEntity()
        {
            // Arrange
            var request = new Create[ENTITY]Request
            {
                Name = "Complete Entity",
                Description = "Full description",

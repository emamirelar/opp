        #region Read Operations

        /// <summary>
        /// Get by ID for existing entity should return entity
        /// </summary>
        [Fact]
        public async Task GetById_ExistingId_ReturnsEntity()
        {
            // Arrange
            var created = await CreateTestEntityAsync();

            // Act
            var result = await _manager.GetByIdAsync(created.Id);

            // Assert
            result.Should().NotBeNull();
            result.Id.Should().Be(created.Id);
        }

        /// <summary>
        /// Get all should return list of entities
        /// </summary>
        [Fact]
        public async Task GetAll_WithExistingEntities_ReturnsNonEmptyList()
        {
            // Arrange
            await CreateTestEntityAsync();
            await CreateTestEntityAsync();

            // Act
            var result = await _manager.GetAllAsync();

            // Assert
            result.Should().NotBeEmpty();
            result.Should().HaveCountGreaterThanOrEqualTo(2);
        }

        /// <summary>
        /// Get all with pagination should return correct page
        /// </summary>
        [Fact]
        public async Task GetAll_WithPagination_ReturnsCorrectPage()
        {
            // Arrange
            for (int i = 0; i < 15; i++)
            {
                await CreateTestEntityAsync();
            }

            // Act
            var result = await _manager.GetAllAsync(page: 1, pageSize: 10);

            // Assert
            result.Items.Should().HaveCount(10);
            result.TotalCount.Should().BeGreaterThanOrEqualTo(15);
        }

        #endregion

        #region Update Operations

        /// <summary>
        /// Update existing entity with valid data should succeed
        /// </summary>
        [Fact]
        public async Task Update_ValidData_ReturnsUpdatedEntity()
        {
            // Arrange
            var created = await CreateTestEntityAsync();
            var updateRequest = new Update[ENTITY]Request
            {
                Id = created.Id,
                Name = "Updated Name"
            };

            // Act
            var result = await _manager.UpdateAsync(updateRequest);

            // Assert
            result.Should().NotBeNull();
            result.Name.Should().Be("Updated Name");
        }

        /// <summary>
        /// Partial update should only modify specified fields
        /// </summary>
        [Fact]
        public async Task Update_PartialData_OnlyUpdatesSpecifiedFields()
        {
            // Arrange
            var created = await CreateTestEntityAsync();
            var originalDescription = created.Description;
            var updateRequest = new Update[ENTITY]Request
            {
                Id = created.Id,
                Name = "New Name Only"
                // Description not specified
            };

            // Act
            var result = await _manager.UpdateAsync(updateRequest);

            // Assert
            result.Name.Should().Be("New Name Only");
            result.Description.Should().Be(originalDescription);
        }

        #endregion

        #region Delete Operations

        /// <summary>
        /// Delete existing entity should soft delete (IsDeleted = true)
        /// </summary>
        [Fact]
        public async Task Delete_ExistingEntity_SoftDeletes()
        {
            // Arrange
            var created = await CreateTestEntityAsync();

            // Act
            await _manager.DeleteAsync(created.Id);

            // Assert
            var deleted = await Context.[ENTITY]s
                .IgnoreQueryFilters()
                .FirstOrDefaultAsync(e => e.Id == created.Id);
            deleted.Should().NotBeNull();
            deleted!.IsDeleted.Should().BeTrue();
        }

        #endregion

        #region Filter Operations

        /// <summary>
        /// Filter by status should return matching entities
        /// </summary>
        [Fact]
        public async Task GetAll_FilterByStatus_ReturnsMatchingEntities()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            await _manager.UpdateStatusAsync(entity.Id, EntityStatus.Active);

            // Act
            var result = await _manager.GetAllAsync(status: EntityStatus.Active);

            // Assert
            result.Should().NotBeEmpty();
            result.All(e => e.Status == EntityStatus.Active).Should().BeTrue();
        }

        /// <summary>
        /// Search by name should return matching entities
        /// </summary>
        [Fact]
        public async Task GetAll_SearchByName_ReturnsMatchingEntities()
        {
            // Arrange
            var uniqueName = $"UniqueSearch_{Guid.NewGuid():N}";
            await CreateTestEntityAsync(uniqueName);

            // Act
            var result = await _manager.GetAllAsync(searchText: uniqueName);

            // Assert
            result.Should().ContainSingle(e => e.Name == uniqueName);
        }

        #endregion

        #region Sorting Operations

        /// <summary>
        /// Sort by name ascending should return correctly ordered results
        /// </summary>
        [Fact]
        public async Task GetAll_SortByNameAscending_ReturnsOrderedResults()
        {
            // Arrange
            await CreateTestEntityAsync("Alpha");
            await CreateTestEntityAsync("Beta");
            await CreateTestEntityAsync("Gamma");

            // Act
            var result = await _manager.GetAllAsync(sortBy: "Name", sortDirection: "ASC");

            // Assert
            result.Should().BeInAscendingOrder(e => e.Name);
        }

        #endregion

        #region Related Entity Operations

        /// <summary>

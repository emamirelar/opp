                RelatedEntityId = relatedEntity.Id
            };

            // Act
            var result = await _manager.CreateAsync(request);

            // Assert
            result.RelatedEntityId.Should().Be(relatedEntity.Id);
        }

        #endregion

        #region Workflow Operations

        /// <summary>
        /// Valid status transition should succeed
        /// </summary>
        [Fact]
        public async Task UpdateStatus_ValidTransition_Succeeds()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();

            // Act
            var result = await _manager.UpdateStatusAsync(entity.Id, EntityStatus.Active);

            // Assert
            result.Status.Should().Be(EntityStatus.Active);
        }


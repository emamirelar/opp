using FluentAssertions;
using Microsoft.EntityFrameworkCore;
using Xunit;

namespace UNOPS.PAO.Business.Tests.[MODULE]
{
    /// <summary>
    /// Concurrency Tests for [ENTITY] Manager
    /// 
    /// Test Strategy: These tests verify correct behavior under concurrent
    /// access, including race conditions, optimistic locking, and deadlocks.
    /// 
    /// Required: ≥25 tests (FIXED minimum - does not scale with positive tests)
    /// 
    /// Coverage: Race conditions, Optimistic concurrency, Deadlock prevention
    /// </summary>
    public class [ENTITY]ConcurrencyTests : ConcurrencyTestBase
    {
        private readonly [ENTITY]Manager _manager;

        public [ENTITY]ConcurrencyTests()
        {
            _manager = new [ENTITY]Manager(Context);
        }

        #region Optimistic Concurrency

        /// <summary>
        /// Concurrent updates with stale data should throw concurrency exception
        /// </summary>
        [Fact]
        public async Task Update_StaleRowVersion_ThrowsDbUpdateConcurrencyException()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            var staleVersion = entity.RowVersion;

            // Simulate another update
            await _manager.UpdateAsync(new Update[ENTITY]Request
            {
                Id = entity.Id,
                Name = "Update 1"
            });

            // Act - Try to update with stale version
            var staleRequest = new Update[ENTITY]Request
            {
                Id = entity.Id,
                Name = "Update 2 (stale)",
                RowVersion = staleVersion
            };
            var act = () => _manager.UpdateAsync(staleRequest);

            // Assert
            await act.Should().ThrowAsync<DbUpdateConcurrencyException>();
        }

        /// <summary>
        /// Concurrent updates should maintain data integrity
        /// </summary>
        [Fact]
        public async Task ConcurrentUpdates_DataIntegrityMaintained()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            var initialValue = 0;
            await _manager.UpdateAsync(new Update[ENTITY]Request
            {
                Id = entity.Id,
                Counter = initialValue
            });

            // Act - Concurrent increments
            var tasks = Enumerable.Range(1, 10)
                .Select(_ => IncrementCounterAsync(entity.Id));

            var results = await Task.WhenAll(tasks);

            // Assert - Final value should equal number of successful increments
            var finalEntity = await _manager.GetByIdAsync(entity.Id);
            var successCount = results.Count(r => r);
            finalEntity.Counter.Should().Be(initialValue + successCount);
        }

        #endregion

        #region Race Conditions

        /// <summary>
        /// Parallel creates should not create duplicates
        /// </summary>
        [Fact]
        public async Task ParallelCreate_UniqueConstraint_OnlyOneSucceeds()
        {
            // Arrange
            var uniqueName = $"Unique_{Guid.NewGuid():N}";
            var createTasks = Enumerable.Range(1, 5)
                .Select(_ => Task.Run(async () =>
                {
                    try
                    {
                        await _manager.CreateAsync(new Create[ENTITY]Request { Name = uniqueName });
                        return true;
                    }
                    catch
                    {
                        return false;
                    }
                }));

            // Act
            var results = await Task.WhenAll(createTasks);

            // Assert - Only one should succeed due to unique constraint
            results.Count(r => r).Should().Be(1);
        }

        /// <summary>
        /// Parallel deletes should be idempotent
        /// </summary>
        [Fact]
        public async Task ParallelDelete_SameEntity_OnlyOneSucceeds()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();

            // Act
            var deleteTasks = Enumerable.Range(1, 5)
                .Select(_ => Task.Run(async () =>
                {
                    try
                    {
                        await _manager.DeleteAsync(entity.Id);
                        return true;
                    }
                    catch
                    {
                        return false;
                    }
                }));

            var results = await Task.WhenAll(deleteTasks);

            // Assert - Only one should succeed
            results.Count(r => r).Should().Be(1);

            // Verify entity is deleted
            var act = () => _manager.GetByIdAsync(entity.Id);
            await act.Should().ThrowAsync<KeyNotFoundException>();
        }

        /// <summary>
        /// Double-submit should be prevented
        /// </summary>
        [Fact]
        public async Task ParallelSubmit_SameEntity_OnlyOneSucceeds()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            var idempotencyKey = Guid.NewGuid().ToString();

            // Act
            var submitTasks = Enumerable.Range(1, 3)
                .Select(_ => Task.Run(async () =>
                {
                    try
                    {
                        await _manager.SubmitAsync(entity.Id, idempotencyKey);
                        return true;
                    }
                    catch
                    {
                        return false;
                    }
                }));

            var results = await Task.WhenAll(submitTasks);

            // Assert - Only one should succeed
            results.Count(r => r).Should().Be(1);
        }

        #endregion

        #region Parallel Reads

        /// <summary>
        /// Parallel reads should not block each other
        /// </summary>
        [Fact]
        public async Task ParallelReads_NoBlocking()
        {
            // Arrange
            var entities = new List<int>();
            for (int i = 0; i < 10; i++)
            {
                var entity = await CreateTestEntityAsync();
                entities.Add(entity.Id);
            }

            // Act
            var stopwatch = System.Diagnostics.Stopwatch.StartNew();
            var readTasks = entities.Select(id => _manager.GetByIdAsync(id));
            await Task.WhenAll(readTasks);
            stopwatch.Stop();

            // Assert - Parallel reads should be fast
            stopwatch.ElapsedMilliseconds.Should().BeLessThan(5000);
        }

        /// <summary>
        /// Read during write should return consistent data
        /// </summary>
        [Fact]
        public async Task ReadDuringWrite_ConsistentData()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            var readResults = new List<string>();

            // Act - Start a slow update
            var updateTask = Task.Run(async () =>
            {
                await _manager.UpdateAsync(new Update[ENTITY]Request
                {
                    Id = entity.Id,
                    Name = "Updated Name"
                });
            });

            // Concurrent reads
            var readTasks = Enumerable.Range(1, 5)
                .Select(_ => Task.Run(async () =>
                {
                    var result = await _manager.GetByIdAsync(entity.Id);
                    lock (readResults)
                    {
                        readResults.Add(result.Name);
                    }
                }));

            await Task.WhenAll(updateTask);
            await Task.WhenAll(readTasks);

            // Assert - All reads should return either old or new value, not partial
            foreach (var name in readResults)
            {
                name.Should().NotBeNullOrEmpty();
                name.Should().BeOneOf(entity.Name, "Updated Name");
            }
        }

        #endregion

        #region Locking

        /// <summary>
        /// Lock should prevent concurrent modifications
        /// </summary>
        [Fact]
        public async Task AcquireLock_ConcurrentModification_Blocked()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();

            // Act - Acquire lock
            using (var lockHandle = await _manager.AcquireLockAsync(entity.Id))
            {
                // Try to modify from another "thread"
                var concurrentTask = Task.Run(async () =>
                {
                    try
                    {
                        await _manager.UpdateAsync(new Update[ENTITY]Request
                        {
                            Id = entity.Id,
                            Name = "Blocked Update"
                        });
                        return true;
                    }
                    catch (LockException)
                    {
                        return false;
                    }
                });

                var result = await concurrentTask;

                // Assert
                result.Should().BeFalse();
            }
        }

        /// <summary>
        /// Lock should be released after timeout
        /// </summary>
        [Fact]
        public async Task Lock_AfterTimeout_Released()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            var lockTimeout = TimeSpan.FromSeconds(2);

            // Acquire lock and abandon it (simulate crash)
            using (await _manager.AcquireLockAsync(entity.Id, lockTimeout))
            {
                // Do nothing - let timeout expire
            }

            // Wait for lock to expire
            await Task.Delay(lockTimeout + TimeSpan.FromSeconds(1));

            // Act - Should be able to acquire lock now
            using var newLock = await _manager.AcquireLockAsync(entity.Id);

            // Assert
            newLock.Should().NotBeNull();
        }

        #endregion

        #region Deadlock Prevention

        /// <summary>
        /// Circular dependency updates should not deadlock
        /// </summary>
        [Fact]
        public async Task CircularUpdates_NoDeadlock()
        {
            // Arrange
            var entity1 = await CreateTestEntityAsync();
            var entity2 = await CreateTestEntityAsync();

            // Act - Cross-update that could cause deadlock
            var task1 = Task.Run(async () =>
            {
                await _manager.UpdateAsync(new Update[ENTITY]Request { Id = entity1.Id, RelatedEntityId = entity2.Id });
                await _manager.UpdateAsync(new Update[ENTITY]Request { Id = entity2.Id, Name = "Updated by Task1" });
            });

            var task2 = Task.Run(async () =>
            {
                await _manager.UpdateAsync(new Update[ENTITY]Request { Id = entity2.Id, RelatedEntityId = entity1.Id });
                await _manager.UpdateAsync(new Update[ENTITY]Request { Id = entity1.Id, Name = "Updated by Task2" });
            });

            // Assert - Should complete without deadlock (timeout would fail this)
            var timeout = Task.Delay(TimeSpan.FromSeconds(30));
            var completed = await Task.WhenAny(Task.WhenAll(task1, task2), timeout);
            completed.Should().NotBe(timeout, "Tasks should complete without deadlock");
        }

        #endregion

        #region Transaction Isolation

        /// <summary>
        /// Transaction should not see uncommitted changes
        /// </summary>
        [Fact]
        public async Task Transaction_ReadUncommitted_NotVisible()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            var originalName = entity.Name;
            var newName = "Uncommitted Change";

            // Act
            using (var transaction = await Context.Database.BeginTransactionAsync())
            {
                entity.Name = newName;
                await Context.SaveChangesAsync();
                // Don't commit

                // Read from another context
                using (var separateContext = CreateSeparateContext())
                {
                    var separateManager = new [ENTITY]Manager(separateContext);
                    var readEntity = await separateManager.GetByIdAsync(entity.Id);

                    // Assert - Should see original value (transaction not committed)
                    readEntity.Name.Should().Be(originalName);
                }

                await transaction.RollbackAsync();
            }
        }

        #endregion

        #region Bulk Operations

        /// <summary>
        /// Bulk create should be atomic
        /// </summary>
        [Fact]
        public async Task BulkCreate_PartialFailure_AllRolledBack()
        {
            // Arrange
            var requests = new List<Create[ENTITY]Request>
            {
                new Create[ENTITY]Request { Name = "Valid 1" },
                new Create[ENTITY]Request { Name = "Valid 2" },
                new Create[ENTITY]Request { Name = null! }, // Invalid - will cause failure
                new Create[ENTITY]Request { Name = "Valid 3" }
            };

            var initialCount = await _manager.GetCountAsync();

            // Act
            var act = () => _manager.BulkCreateAsync(requests);

            // Assert
            await act.Should().ThrowAsync<ValidationException>();

            // Verify no partial insert
            var finalCount = await _manager.GetCountAsync();
            finalCount.Should().Be(initialCount);
        }

        /// <summary>
        /// Bulk update should handle concurrent modifications
        /// </summary>
        [Fact]
        public async Task BulkUpdate_ConcurrentModification_HandledGracefully()
        {
            // Arrange
            var entities = new List<int>();
            for (int i = 0; i < 10; i++)
            {
                var entity = await CreateTestEntityAsync();
                entities.Add(entity.Id);
            }

            // Act - Bulk update while concurrent single updates happen
            var bulkTask = _manager.BulkUpdateAsync(entities, e => e.Status = EntityStatus.Active);
            var singleTasks = entities.Take(3).Select(id =>
                _manager.UpdateAsync(new Update[ENTITY]Request { Id = id, Name = "Single Update" }));

            await Task.WhenAll(new[] { bulkTask }.Concat(singleTasks));

            // Assert - All entities should be in consistent state
            foreach (var id in entities)
            {
                var entity = await _manager.GetByIdAsync(id);
                entity.Status.Should().Be(EntityStatus.Active);
            }
        }

        #endregion

        #region Helper Methods

        private async Task<[ENTITY]Model> CreateTestEntityAsync(string? name = null)
        {
            var request = new Create[ENTITY]Request
            {
                Name = name ?? $"Test Entity {Guid.NewGuid():N}"[..30]
            };
            return await _manager.CreateAsync(request);
        }

        private async Task<bool> IncrementCounterAsync(int entityId)
        {
            try
            {
                var entity = await _manager.GetByIdAsync(entityId);
                await _manager.UpdateAsync(new Update[ENTITY]Request
                {
                    Id = entityId,
                    Counter = entity.Counter + 1,
                    RowVersion = entity.RowVersion
                });
                return true;
            }
            catch (DbUpdateConcurrencyException)
            {
                return false;
            }
        }

        private AppDbContext CreateSeparateContext()
        {
            // Create a new DbContext instance for isolation testing
            throw new NotImplementedException();
        }

        #endregion
    }
}

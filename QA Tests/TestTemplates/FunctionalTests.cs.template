        #region Business Rule: Audit Trail

        /// <summary>
        /// BRT-001: All changes must be tracked in audit log
        /// </summary>
        [Fact]
        public async Task BRT001_UpdateEntity_CreatesAuditEntry()
        {
            // Arrange
            var entity = await CreateDraftEntityAsync();

            // Act
            await _manager.UpdateAsync(new Update[ENTITY]Request
            {
                Id = entity.Id,
                Name = "Modified Name"
            });

            // Assert
            var auditLogs = await Context.AuditLogs
                .Where(a => a.EntityId == entity.Id && a.EntityType == "[ENTITY]")
                .ToListAsync();

            auditLogs.Should().Contain(a => a.Action == "Update");
        }

        /// <summary>
        /// BRT-002: Audit log captures who made the change
        /// </summary>
        [Fact]
        public async Task BRT002_UpdateEntity_CapturesUserId()
        {
            // Arrange
            var entity = await CreateDraftEntityAsync();
            var currentUserId = GetCurrentUserId();

            // Act
            await _manager.UpdateAsync(new Update[ENTITY]Request
            {
                Id = entity.Id,
                Name = "Modified Name"
            });

            // Assert
            var latestAudit = await Context.AuditLogs
                .Where(a => a.EntityId == entity.Id)
                .OrderByDescending(a => a.CreatedDate)
                .FirstAsync();

            latestAudit.UserId.Should().Be(currentUserId);
        }


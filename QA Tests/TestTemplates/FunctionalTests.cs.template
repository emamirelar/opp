        #region Business Rule: Amount Limits

        /// <summary>
        /// BRA-001: Total amount must not exceed budget limit
        /// </summary>
        [Fact]
        public async Task BRA001_AddAmount_ExceedsBudget_ThrowsError()
        {
            // Arrange
            var entity = await CreateEntityWithBudgetAsync(budgetLimit: 10000m);
            await AddAmountAsync(entity.Id, 8000m); // Under budget

            // Act - Try to add amount that exceeds remaining
            var act = () => AddAmountAsync(entity.Id, 5000m);

            // Assert
            await act.Should().ThrowAsync<BusinessException>()
                .WithMessage("*exceeds budget*");
        }

        /// <summary>
        /// BRA-002: Amount at exactly budget limit is allowed
        /// </summary>
        [Fact]
        public async Task BRA002_AddAmount_ExactlyAtBudget_Succeeds()
        {
            // Arrange
            var entity = await CreateEntityWithBudgetAsync(budgetLimit: 10000m);

            // Act - Add exact budget amount
            await AddAmountAsync(entity.Id, 10000m);

            // Assert
            var result = await _manager.GetByIdAsync(entity.Id);
            result.TotalAmount.Should().Be(10000m);
            result.RemainingBudget.Should().Be(0m);
        }

        #endregion

        #region Business Rule: Required Fields by Stage

        /// <summary>
        /// BRS-001: Description is optional in Draft stage
        /// </summary>
        [Fact]
        public async Task BRS001_CreateDraft_NoDescription_Succeeds()
        {
            // Arrange
            var request = new Create[ENTITY]Request
            {
                Name = "Draft Entity"
                // No description
            };

            // Act
            var result = await _manager.CreateAsync(request);

            // Assert
            result.Should().NotBeNull();
            result.Status.Should().Be(EntityStatus.Draft);
        }

        /// <summary>
        /// BRS-002: Description is required when submitting for approval
        /// </summary>
        [Fact]
        public async Task BRS002_SubmitForApproval_NoDescription_ThrowsError()
        {
            // Arrange
            var entity = await _manager.CreateAsync(new Create[ENTITY]Request { Name = "Test" });

            // Act - Submit without description
            var act = () => _manager.SubmitForApprovalAsync(entity.Id);


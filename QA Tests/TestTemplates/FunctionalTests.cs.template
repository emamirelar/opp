        #region Business Rule: Unique Name

        /// <summary>
        /// BRU-001: [ENTITY] names must be unique within the organization
        /// </summary>
        [Fact]
        public async Task BR001_CreateEntity_NameMustBeUnique()
        {
            // Arrange - Create first entity
            var entity1 = await _manager.CreateAsync(new Create[ENTITY]Request
            {
                Name = "Unique Name",
                OrganizationId = 1
            });

            // Act - Try to create second entity with same name
            var act = () => _manager.CreateAsync(new Create[ENTITY]Request
            {
                Name = "Unique Name",
                OrganizationId = 1
            });

            // Assert
            await act.Should().ThrowAsync<BusinessException>()
                .WithMessage("*already exists*");
        }

        /// <summary>
        /// BRU-002: Same name allowed in different organizations
        /// </summary>
        [Fact]
        public async Task BR002_CreateEntity_SameNameDifferentOrg_Allowed()
        {
            // Arrange - Create first entity in org 1
            await _manager.CreateAsync(new Create[ENTITY]Request
            {
                Name = "Common Name",
                OrganizationId = 1
            });

            // Act - Create second entity with same name in org 2
            var entity2 = await _manager.CreateAsync(new Create[ENTITY]Request
            {
                Name = "Common Name",
                OrganizationId = 2
            });

            // Assert
            entity2.Should().NotBeNull();
            entity2.Name.Should().Be("Common Name");
        }

        #endregion

        #region Business Rule: Approval Workflow

        /// <summary>
        /// BRW-001: Entities require approval before activation
        /// </summary>
        [Fact]
        public async Task BRW001_ActivateEntity_RequiresApproval()
        {
            // Arrange - Create draft entity
            var entity = await CreateDraftEntityAsync();

            // Act - Try to activate without approval
            var act = () => _manager.UpdateStatusAsync(entity.Id, EntityStatus.Active);

            // Assert
            await act.Should().ThrowAsync<BusinessException>()
                .WithMessage("*approval required*");
        }

        /// <summary>
        /// BRW-002: Approved entities can be activated
        /// </summary>
        [Fact]
        public async Task BRW002_ActivateEntity_AfterApproval_Succeeds()
        {
            // Arrange - Create and approve entity
            var entity = await CreateDraftEntityAsync();
            await _manager.ApproveAsync(entity.Id);

            // Act - Activate approved entity
            var result = await _manager.UpdateStatusAsync(entity.Id, EntityStatus.Active);

            // Assert
            result.Status.Should().Be(EntityStatus.Active);
        }

        /// <summary>
        /// BRW-003: Rejected entities return to draft
        /// </summary>
        [Fact]
        public async Task BRW003_RejectEntity_ReturnsToDraft()
        {
            // Arrange - Create entity and submit for approval
            var entity = await CreateDraftEntityAsync();
            await _manager.SubmitForApprovalAsync(entity.Id);

            // Act - Reject the entity
            var result = await _manager.RejectAsync(entity.Id, "Not meeting criteria");

            // Assert
            result.Status.Should().Be(EntityStatus.Draft);
            result.RejectionReason.Should().Be("Not meeting criteria");
        }

        #endregion

        #region Business Rule: Deletion Constraints

        /// <summary>
        /// BRD-001: Entities with active children cannot be deleted
        /// </summary>
        [Fact]
        public async Task BRD001_DeleteEntity_WithActiveChildren_Blocked()
        {
            // Arrange - Create entity with active child
            var parent = await _manager.CreateAsync(new Create[ENTITY]Request { Name = "Parent" });
            await CreateChildEntityAsync(parent.Id, isActive: true);

            // Act
            var act = () => _manager.DeleteAsync(parent.Id);

            // Assert
            await act.Should().ThrowAsync<BusinessException>()
                .WithMessage("*active child*");
        }

        /// <summary>
        /// BRD-002: Entities with only inactive children can be deleted
        /// </summary>
        [Fact]
        public async Task BRD002_DeleteEntity_WithInactiveChildren_Allowed()
        {
            // Arrange - Create entity with inactive child
            var parent = await _manager.CreateAsync(new Create[ENTITY]Request { Name = "Parent" });
            await CreateChildEntityAsync(parent.Id, isActive: false);

            // Act
            await _manager.DeleteAsync(parent.Id);

            // Assert
            var act = () => _manager.GetByIdAsync(parent.Id);
            await act.Should().ThrowAsync<KeyNotFoundException>();
        }

        #endregion


using FluentAssertions;
using Microsoft.EntityFrameworkCore;
using System.Diagnostics;
using Xunit;

namespace UNOPS.PAO.Business.Tests.[MODULE]
{
    /// <summary>
    /// Performance Tests for [ENTITY] Manager
    /// 
    /// Test Strategy: These tests verify response times, throughput,
    /// and behavior under load.
    /// 
    /// Required: At least 1 test (no scaling minimum)
    /// 
    /// Characteristics:
    /// - Measures execution time
    /// - Tests concurrent access
    /// - Verifies memory usage
    /// - Tests pagination efficiency
    /// </summary>
    public class [ENTITY]PerformanceTests : ManagerTestBase
    {
        private readonly [ENTITY]Manager _manager;
        private readonly Stopwatch _stopwatch;

        // Performance thresholds (adjust based on requirements)
        private const int MaxSingleOperationMs = 500;
        private const int MaxBulkOperationMs = 5000;
        private const int MaxSearchOperationMs = 1000;
        private const int MaxPaginatedQueryMs = 200;

        public [ENTITY]PerformanceTests()
        {
            _manager = new [ENTITY]Manager(Context);
            _stopwatch = new Stopwatch();
        }

        #region Single Operation Performance

        /// <summary>
        /// Create operation completes within acceptable time
        /// </summary>
        [Fact]
        public async Task Create_SingleEntity_CompletesWithinThreshold()
        {
            // Arrange
            var request = new Create[ENTITY]Request
            {
                Name = "Performance Test Entity"
            };

            // Act
            _stopwatch.Restart();
            var result = await _manager.CreateAsync(request);
            _stopwatch.Stop();

            // Assert
            result.Should().NotBeNull();
            _stopwatch.ElapsedMilliseconds.Should().BeLessThan(MaxSingleOperationMs,
                $"Create operation took {_stopwatch.ElapsedMilliseconds}ms, expected < {MaxSingleOperationMs}ms");
        }

        /// <summary>
        /// Get by ID operation completes within acceptable time
        /// </summary>
        [Fact]
        public async Task GetById_ExistingEntity_CompletesWithinThreshold()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();

            // Act
            _stopwatch.Restart();
            var result = await _manager.GetByIdAsync(entity.Id);
            _stopwatch.Stop();

            // Assert
            result.Should().NotBeNull();
            _stopwatch.ElapsedMilliseconds.Should().BeLessThan(MaxSingleOperationMs,
                $"GetById operation took {_stopwatch.ElapsedMilliseconds}ms, expected < {MaxSingleOperationMs}ms");
        }

        /// <summary>
        /// Update operation completes within acceptable time
        /// </summary>
        [Fact]
        public async Task Update_ExistingEntity_CompletesWithinThreshold()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            var request = new Update[ENTITY]Request
            {
                Id = entity.Id,
                Name = "Updated Name"
            };

            // Act
            _stopwatch.Restart();
            var result = await _manager.UpdateAsync(request);
            _stopwatch.Stop();

            // Assert
            result.Should().NotBeNull();
            _stopwatch.ElapsedMilliseconds.Should().BeLessThan(MaxSingleOperationMs,
                $"Update operation took {_stopwatch.ElapsedMilliseconds}ms, expected < {MaxSingleOperationMs}ms");
        }

        /// <summary>
        /// Delete operation completes within acceptable time
        /// </summary>
        [Fact]
        public async Task Delete_ExistingEntity_CompletesWithinThreshold()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();

            // Act
            _stopwatch.Restart();
            await _manager.DeleteAsync(entity.Id);
            _stopwatch.Stop();

            // Assert
            _stopwatch.ElapsedMilliseconds.Should().BeLessThan(MaxSingleOperationMs,
                $"Delete operation took {_stopwatch.ElapsedMilliseconds}ms, expected < {MaxSingleOperationMs}ms");
        }

        #endregion

        #region Bulk Operation Performance

        /// <summary>
        /// Bulk create handles 100 entities within acceptable time
        /// </summary>
        [Fact]
        public async Task BulkCreate_100Entities_CompletesWithinThreshold()
        {
            // Arrange
            var requests = Enumerable.Range(1, 100)
                .Select(i => new Create[ENTITY]Request { Name = $"Bulk Entity {i}" })
                .ToList();

            // Act
            _stopwatch.Restart();
            var results = await _manager.BulkCreateAsync(requests);
            _stopwatch.Stop();

            // Assert
            results.Should().HaveCount(100);
            _stopwatch.ElapsedMilliseconds.Should().BeLessThan(MaxBulkOperationMs,
                $"Bulk create of 100 entities took {_stopwatch.ElapsedMilliseconds}ms, expected < {MaxBulkOperationMs}ms");
        }

        /// <summary>
        /// Bulk update handles 100 entities within acceptable time
        /// </summary>
        [Fact]
        public async Task BulkUpdate_100Entities_CompletesWithinThreshold()
        {
            // Arrange - Create entities first
            var entities = new List<int>();
            for (int i = 0; i < 100; i++)
            {
                var entity = await CreateTestEntityAsync($"Bulk Update Entity {i}");
                entities.Add(entity.Id);
            }

            // Act
            _stopwatch.Restart();
            await _manager.BulkUpdateStatusAsync(entities, EntityStatus.Active);
            _stopwatch.Stop();

            // Assert
            _stopwatch.ElapsedMilliseconds.Should().BeLessThan(MaxBulkOperationMs,
                $"Bulk update of 100 entities took {_stopwatch.ElapsedMilliseconds}ms, expected < {MaxBulkOperationMs}ms");
        }

        #endregion

        #region Query Performance

        /// <summary>
        /// GetAll with large dataset returns quickly using pagination
        /// </summary>
        [Fact]
        public async Task GetAll_LargeDataset_UsesPaginationEfficiently()
        {
            // Arrange - Ensure many entities exist
            await SeedManyEntitiesAsync(1000);

            // Act - Request first page only
            _stopwatch.Restart();
            var result = await _manager.GetAllAsync(pageSize: 20, pageIndex: 0);
            _stopwatch.Stop();

            // Assert
            result.Items.Should().HaveCount(20);
            _stopwatch.ElapsedMilliseconds.Should().BeLessThan(MaxPaginatedQueryMs,
                $"Paginated query took {_stopwatch.ElapsedMilliseconds}ms, expected < {MaxPaginatedQueryMs}ms");
        }

        /// <summary>
        /// Search operation scales well with data size
        /// </summary>
        [Fact]
        public async Task Search_LargeDataset_CompletesWithinThreshold()
        {
            // Arrange
            await SeedManyEntitiesAsync(1000);

            // Act
            _stopwatch.Restart();
            var result = await _manager.GetAllAsync(searchText: "Performance");
            _stopwatch.Stop();

            // Assert
            _stopwatch.ElapsedMilliseconds.Should().BeLessThan(MaxSearchOperationMs,
                $"Search operation took {_stopwatch.ElapsedMilliseconds}ms, expected < {MaxSearchOperationMs}ms");
        }

        /// <summary>
        /// Complex filter query performs within acceptable time
        /// </summary>
        [Fact]
        public async Task GetAll_ComplexFilters_CompletesWithinThreshold()
        {
            // Arrange
            await SeedManyEntitiesAsync(500);

            // Act - Apply multiple filters
            _stopwatch.Restart();
            var result = await _manager.GetAllAsync(
                status: EntityStatus.Active,
                searchText: "Test",
                sortBy: "Name",
                sortDirection: "ASC",
                pageSize: 50
            );
            _stopwatch.Stop();

            // Assert
            _stopwatch.ElapsedMilliseconds.Should().BeLessThan(MaxSearchOperationMs,
                $"Complex filter query took {_stopwatch.ElapsedMilliseconds}ms, expected < {MaxSearchOperationMs}ms");
        }

        #endregion

        #region Concurrent Access Performance

        /// <summary>
        /// Concurrent reads do not degrade performance
        /// </summary>
        [Fact]
        public async Task ConcurrentReads_50Parallel_MaintainsPerformance()
        {
            // Arrange
            var entity = await CreateTestEntityAsync();
            var tasks = new List<Task<[ENTITY]Model>>();

            // Act
            _stopwatch.Restart();
            for (int i = 0; i < 50; i++)
            {
                tasks.Add(_manager.GetByIdAsync(entity.Id));
            }
            await Task.WhenAll(tasks);
            _stopwatch.Stop();

            // Assert
            tasks.All(t => t.Result != null).Should().BeTrue();
            var avgTime = _stopwatch.ElapsedMilliseconds / 50.0;
            avgTime.Should().BeLessThan(100,
                $"Average read time was {avgTime}ms, expected < 100ms per read");
        }

        /// <summary>
        /// Concurrent writes maintain data integrity
        /// </summary>
        [Fact]
        public async Task ConcurrentWrites_10Parallel_AllSucceed()
        {
            // Arrange
            var tasks = new List<Task<[ENTITY]Model>>();

            // Act
            _stopwatch.Restart();
            for (int i = 0; i < 10; i++)
            {
                var request = new Create[ENTITY]Request { Name = $"Concurrent Entity {i}" };
                tasks.Add(_manager.CreateAsync(request));
            }
            var results = await Task.WhenAll(tasks);
            _stopwatch.Stop();

            // Assert
            results.Should().HaveCount(10);
            results.Should().OnlyContain(r => r != null);
            _stopwatch.ElapsedMilliseconds.Should().BeLessThan(MaxBulkOperationMs,
                $"10 concurrent creates took {_stopwatch.ElapsedMilliseconds}ms, expected < {MaxBulkOperationMs}ms");
        }

        #endregion

        #region Memory Performance

        /// <summary>
        /// Large query does not cause excessive memory allocation
        /// </summary>
        [Fact]
        public async Task GetAll_LargeResult_MemoryUsageReasonable()
        {
            // Arrange
            await SeedManyEntitiesAsync(1000);
            GC.Collect();
            var memoryBefore = GC.GetTotalMemory(true);

            // Act
            var result = await _manager.GetAllAsync(pageSize: 1000);

            GC.Collect();
            var memoryAfter = GC.GetTotalMemory(true);

            // Assert
            var memoryUsedMB = (memoryAfter - memoryBefore) / (1024 * 1024);
            memoryUsedMB.Should().BeLessThan(100,
                $"Query used {memoryUsedMB}MB memory, expected < 100MB");
        }

        /// <summary>
        /// Repeated operations do not cause memory leaks
        /// </summary>
        [Fact]
        public async Task RepeatedOperations_NoMemoryLeak()
        {
            // Arrange
            GC.Collect();
            var memoryBefore = GC.GetTotalMemory(true);

            // Act - Perform many operations
            for (int i = 0; i < 100; i++)
            {
                var entity = await CreateTestEntityAsync($"Memory Test {i}");
                await _manager.GetByIdAsync(entity.Id);
                await _manager.DeleteAsync(entity.Id);
            }

            GC.Collect();
            var memoryAfter = GC.GetTotalMemory(true);

            // Assert
            var memoryGrowthMB = (memoryAfter - memoryBefore) / (1024 * 1024);
            memoryGrowthMB.Should().BeLessThan(50,
                $"Memory grew by {memoryGrowthMB}MB after 100 operations, possible leak");
        }

        #endregion

        #region Stress Testing

        /// <summary>
        /// System handles sustained load
        /// </summary>
        [Fact]
        public async Task SustainedLoad_1000Operations_MaintainsPerformance()
        {
            // Arrange
            var operationTimes = new List<long>();

            // Act - Perform 1000 mixed operations
            for (int i = 0; i < 1000; i++)
            {
                _stopwatch.Restart();
                
                if (i % 3 == 0)
                {
                    await CreateTestEntityAsync($"Stress Test {i}");
                }
                else if (i % 3 == 1)
                {
                    await _manager.GetAllAsync(pageSize: 10);
                }
                else
                {
                    await _manager.GetAllAsync(searchText: "Stress");
                }
                
                _stopwatch.Stop();
                operationTimes.Add(_stopwatch.ElapsedMilliseconds);
            }

            // Assert - Performance should not degrade over time
            var firstQuarter = operationTimes.Take(250).Average();
            var lastQuarter = operationTimes.Skip(750).Average();

            lastQuarter.Should().BeLessThan(firstQuarter * 2,
                $"Performance degraded from {firstQuarter}ms to {lastQuarter}ms average");
        }

        #endregion

        #region Database Query Optimization

        /// <summary>
        /// Query uses indexes efficiently (N+1 prevention)
        /// </summary>
        [Fact]
        public async Task GetAllWithRelated_NoNPlusOneQuery()
        {
            // Arrange
            await SeedEntitiesWithRelatedDataAsync(50);

            // Act - This should be a single query with joins, not 51 queries
            _stopwatch.Restart();
            var result = await _manager.GetAllWithRelatedAsync(pageSize: 50);
            _stopwatch.Stop();

            // Assert
            result.Items.Should().HaveCount(50);
            _stopwatch.ElapsedMilliseconds.Should().BeLessThan(500,
                $"Query took {_stopwatch.ElapsedMilliseconds}ms - possible N+1 problem");
        }

        #endregion

        #region Benchmark Reporting

        /// <summary>
        /// Output performance benchmark for documentation
        /// </summary>
        [Fact]
        public async Task Benchmark_AllOperations_ReportTimes()
        {
            var benchmarks = new Dictionary<string, long>();

            // Create
            var entity = await CreateTestEntityAsync();
            _stopwatch.Restart();
            await _manager.CreateAsync(new Create[ENTITY]Request { Name = "Benchmark" });
            benchmarks["Create"] = _stopwatch.ElapsedMilliseconds;

            // Read
            _stopwatch.Restart();
            await _manager.GetByIdAsync(entity.Id);
            benchmarks["GetById"] = _stopwatch.ElapsedMilliseconds;

            // Update
            _stopwatch.Restart();
            await _manager.UpdateAsync(new Update[ENTITY]Request { Id = entity.Id, Name = "Updated" });
            benchmarks["Update"] = _stopwatch.ElapsedMilliseconds;

            // Delete
            _stopwatch.Restart();
            await _manager.DeleteAsync(entity.Id);
            benchmarks["Delete"] = _stopwatch.ElapsedMilliseconds;

            // GetAll
            _stopwatch.Restart();
            await _manager.GetAllAsync(pageSize: 20);
            benchmarks["GetAll (20 items)"] = _stopwatch.ElapsedMilliseconds;

            // Output benchmarks
            foreach (var (operation, time) in benchmarks)
            {
                Console.WriteLine($"{operation}: {time}ms");
            }

            // All operations should be reasonably fast
            benchmarks.Values.Should().OnlyContain(t => t < MaxSingleOperationMs);
        }

        #endregion

        #region Helper Methods

        private async Task<[ENTITY]Model> CreateTestEntityAsync(string? name = null)
        {
            var request = new Create[ENTITY]Request
            {
                Name = name ?? $"Test Entity {Guid.NewGuid():N}"[..30]
            };
            return await _manager.CreateAsync(request);
        }

        private async Task SeedManyEntitiesAsync(int count)
        {
            var existingCount = await Context.[ENTITY]s.CountAsync();
            if (existingCount >= count) return;

            var requests = Enumerable.Range(1, count - existingCount)
                .Select(i => new Create[ENTITY]Request { Name = $"Performance Test Entity {i}" })
                .ToList();

            await _manager.BulkCreateAsync(requests);
        }

        private async Task SeedEntitiesWithRelatedDataAsync(int count)
        {
            for (int i = 0; i < count; i++)
            {
                var entity = await CreateTestEntityAsync($"Related Test {i}");
                // Add related data
            }
        }

        #endregion
    }
}

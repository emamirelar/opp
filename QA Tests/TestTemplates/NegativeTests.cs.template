        #region SQL Injection Prevention

        /// <summary>
        /// SQL injection in name should be handled safely
        /// </summary>
        [Theory]
        [InlineData("'; DROP TABLE [ENTITY]s; --")]
        [InlineData("1 OR 1=1")]
        [InlineData("' UNION SELECT * FROM Users --")]
        [InlineData("Robert'); DROP TABLE Students;--")]
        public async Task Create_SqlInjectionAttempt_SafelyHandled(string maliciousInput)
        {
            // Arrange
            var request = new Create[ENTITY]Request { Name = maliciousInput };

            // Act - Should either succeed (treating as literal) or throw validation
            Func<Task> act = () => _manager.CreateAsync(request);

            // Assert - Should not execute SQL injection
            // Either creates entity with literal name or throws validation error
            // Database should remain intact
        }

        #endregion

        #region XSS Prevention

        /// <summary>
        /// XSS in name should be sanitized or escaped
        /// </summary>
        [Theory]
        [InlineData("<script>alert('xss')</script>")]
        [InlineData("<img src='x' onerror='alert(1)'>")]
        [InlineData("javascript:alert('xss')")]
        public async Task Create_XssAttempt_SafelyHandled(string maliciousInput)
        {
            // Arrange
            var request = new Create[ENTITY]Request { Name = maliciousInput };

            // Act
            var result = await _manager.CreateAsync(request);

            // Assert - XSS should be escaped/encoded, not executed
            result.Name.Should().NotContain("<script>");
            // Or should throw validation exception if script tags not allowed
        }


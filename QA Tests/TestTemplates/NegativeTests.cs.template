            // Transition through all states to final
            await _manager.UpdateStatusAsync(entity.Id, EntityStatus.Active);
            await _manager.UpdateStatusAsync(entity.Id, EntityStatus.Completed);
            return await _manager.GetByIdAsync(entity.Id);
        }


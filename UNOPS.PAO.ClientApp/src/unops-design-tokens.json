  "spacing": {
    "unops-xs": "4px",
    "unops-sm": "8px",
    "unops-md": "16px",
    "unops-lg": "24px",
    "unops-xl": "32px",
    "unops-2xl": "48px",
    "unops-3xl": "64px"
  },
  "typography": {
    "fontFamily": {
      "unops-display": ["Inter", "Noto Sans", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "system-ui", "sans-serif"],
      "unops-body": ["Inter", "Noto Sans", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "system-ui", "sans-serif"]
    },
    "fontWeight": {
      "unops-light": "300",
      "unops-regular": "400",
      "unops-medium": "500",
      "unops-semibold": "600",
      "unops-bold": "700"
    },
    "fontSize": {
      "unops-xs": "0.75rem",
      "unops-sm": "0.875rem",
      "unops-base": "1rem",
      "unops-lg": "1.125rem",
      "unops-xl": "1.25rem",
      "unops-2xl": "1.5rem",
      "unops-display-large": "2.5rem",
      "unops-display-medium": "2rem",
      "unops-display-small": "1.5rem",
      "unops-headline-large": "1.875rem",
      "unops-headline-medium": "1.5rem",
      "unops-headline-small": "1.25rem",
      "unops-body-large": "1rem",
      "unops-body-medium": "0.875rem",
      "unops-body-small": "0.75rem",
      "unops-label-large": "0.875rem",
      "unops-label-medium": "0.75rem",
      "unops-label-small": "0.6875rem"
    }
  },
  "borderRadius": {
    "unops-xs": "4px",
    "unops-sm": "6px",
    "unops-md": "8px",
    "unops-lg": "12px",
    "unops-xl": "16px",
    "unops-2xl": "20px",
    "unops-full": "9999px"
  },
  "boxShadow": {
    "unops-sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "unops-md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "unops-lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "unops-xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
  },
  "animation": {
    "transitionDuration": {
      "unops-fast": "150ms",
      "unops-short": "200ms",
      "unops-medium": "300ms",
      "unops-normal": "250ms",
      "unops-slow": "350ms"
    },
    "transitionTimingFunction": {
      "unops-standard": "cubic-bezier(0.2, 0.0, 0, 1.0)",
      "unops-decelerate": "cubic-bezier(0.0, 0.0, 0.2, 1.0)",
      "unops-smooth": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "layout": {
    "zIndex": {
      "unops-dropdown": "1000",
      "unops-modal": "1050",
      "unops-toast": "1100",
      "unops-tooltip": "1200"
    },
    "screens": {
      "unops-mobile": {"max": "599px"},
      "unops-tablet": {"min": "600px", "max": "839px"},
      "unops-desktop": {"min": "840px"}
    },
    "minHeight": {
      "unops-touch": "44px"
    },
    "minWidth": {
      "unops-touch": "44px"
    }
  },
  "cssCustomProperties": {
    "description": "All tokens are available as CSS custom properties with --unops- prefix",
    "examples": {
      "colors": "var(--unops-primary), var(--unops-primary-light), var(--unops-surface-primary)",
      "spacing": "var(--unops-spacing-md), var(--unops-spacing-lg)",
      "typography": "var(--unops-font-display), var(--unops-font-size-headline-large)",
      "borderRadius": "var(--unops-radius-md), var(--unops-radius-full)",
      "shadows": "var(--unops-shadow-md), var(--unops-shadow-lg)",
      "animation": "var(--unops-duration-short), var(--unops-easing-standard)"
    }
  },
  "tailwindClasses": {
    "description": "All tokens are available as Tailwind utility classes",
    "examples": {
      "colors": "bg-unops-primary, text-unops-secondary, border-unops-accent-teal",
      "spacing": "p-unops-md, m-unops-lg, gap-unops-sm",
      "typography": "font-unops-display, text-unops-headline-large, font-unops-bold",
      "borderRadius": "rounded-unops-md, rounded-unops-full",
      "shadows": "shadow-unops-md, shadow-unops-lg",
      "gradients": "bg-gradient-rainbow, bg-gradient-professional, text-gradient-ocean-sunset"
    }
  },
  "scssVariables": {
    "description": "All tokens are available as SCSS variables with $unops- prefix",
    "examples": {
      "colors": "$unops-primary, $unops-secondary, $unops-surface-primary",
      "spacing": "$unops-spacing-md, $unops-spacing-lg",
      "typography": "$unops-font-display, $unops-font-size-headline-large"
    }
  },
  "usage": {
    "html": {
      "description": "Using design tokens in HTML with Tailwind classes",
      "example": "<div class=\"bg-unops-primary text-unops-primary-on p-unops-md rounded-unops-lg shadow-unops-md\">UNOPS Component</div>"
    },
    "css": {
      "description": "Using design tokens in CSS with custom properties",
      "example": ".my-component {\n  background-color: var(--unops-primary);\n  color: var(--unops-primary-on);\n  padding: var(--unops-spacing-md);\n  border-radius: var(--unops-radius-lg);\n  box-shadow: var(--unops-shadow-md);\n}"
    },
    "scss": {
      "description": "Using design tokens in SCSS with variables",
      "example": ".my-component {\n  background-color: $unops-primary;\n  color: $unops-primary-on;\n  padding: $unops-spacing-md;\n  border-radius: $unops-radius-lg;\n  box-shadow: $unops-shadow-md;\n}"
    }
  }
}

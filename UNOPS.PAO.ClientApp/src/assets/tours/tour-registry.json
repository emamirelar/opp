{
  "routes": [
    {
      "pattern": "/",
      "tourFile": "homepage-tour",
      "description": "Homepage with main navigation and topbar features"
    },
    {
      "pattern": "/partnerships/partners/:id",
      "tourFile": "partner-view-tour",
      "description": "Partner detail page with tabs"
    },
    {
      "pattern": "/partnerships/partners",
      "tourFile": "partner-list-tour", 
      "description": "Partner list/grid page"
    },
    {
      "pattern": "/partnerships/contacts/:recordId",
      "tourFile": "contactview-tour",
      "description": "Contact detail page"
    },
    {
      "pattern": "/partnerships/contacts",
      "tourFile": "contact-tour",
      "description": "Contact list page"
    },
    {
      "pattern": "/partnerships/interactions/:recordId",
      "tourFile": "interactiondetail-tour",
      "description": "Interaction detail page"
    },
    {
      "pattern": "/partnerships/interactions",
      "tourFile": "interactionlist-tour",
      "description": "Interaction list page"
    },
    {
      "pattern": "/partnerships/opportunities/:id",
      "tourFile": "opportunity-view-tour",
      "description": "Opportunity detail page with tabs"
    },
    {
      "pattern": "/partnerships/opportunities",
      "tourFile": "opportunity-list-tour",
      "description": "Opportunity list/grid page"
    },
    {
      "pattern": "/admin/entity-manager",
      "tourFile": "entitymanager-tour",
      "description": "Entity manager admin page"
    },
    {
      "pattern": "/admin/user-management",
      "tourFile": "usermanagement-tour",
      "description": "User management admin page"
    },
    {
      "pattern": "/admin/partner-tree/:id",

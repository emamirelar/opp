      "description": "Partner tree details page"
    },
    {
      "pattern": "/admin/partner-tree",
      "tourFile": "partnertree-tour",
      "description": "Partner tree admin page"
    },
    {
      "pattern": "/ai",
      "tourFile": "aiassistant-tour", 
      "description": "AI Assistant page"
    },
    {
      "pattern": "/admin/ai-prompt-management",
      "tourFile": "aiprompt-tour",
      "description": "AI Prompts management page"
    },
    {
      "pattern": "/admin/ai-prompt-management",

{
  "entity": "GmailAddon",
  "description": "Manages interactions and related records specifically within the context of a Gmail Add-on, facilitating the creation, update, and lookup of communication logs and associated entities like contacts and partners.",
  "synonyms": [
    "Email interaction",
    "Gmail activity",
    "Email record",
    "Communication log",
    "Addon data"
  ],
  "mandatoryFields": [
    "Type",
    "Date",
    "ConfirmDuplicateCreation"
  ],
  "endpoints": [
    {
      "name": "CreateInteraction",
      "url": "api/gmail-addon/interactions",
      "method": "POST",
      "description": "Creates a new interaction record, typically initiated from the Gmail Add-on. This captures details like interaction type, date, and associated entities.",
      "parameters": {
        "model": {
          "type": "object",
          "required": true,
          "description": "Interaction request payload.",
          "properties": {
            "Type": {
              "type": "string",
              "required": true,
              "description": "Property of type InteractionType"
            },
            "Date": {
              "type": "string",
              "required": true,
              "description": "Property of type DateTime"
            },
            "Description": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "EmailAddresses": {
              "type": "array",
              "required": false,
              "description": "Property of type List<string>"
            },
            "PhoneNumbers": {
              "type": "array",
              "required": false,
              "description": "Property of type List<string>"
            },
            "ContactIds": {
              "type": "array",
              "required": false,
              "description": "Property of type List<int>"
            },
            "PartnerIds": {
              "type": "array",
              "required": false,
              "description": "Property of type List<int>"
            },
            "UserIds": {
              "type": "array",
              "required": false,
              "description": "Property of type List<int>"
            },
            "Location": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "Subject": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "OrganizationHierarchyIds": {
              "type": "array",
              "required": false,
              "description": "Property of type List<int>"
            },
            "GmailThreadId": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "GmailMessageId": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "Status": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "ConfirmDuplicateCreation": {
              "type": "boolean",
              "required": true,
              "description": "Property of type bool"
            },
            "Extensions": {
              "type": "object",
              "required": false,
              "description": "Property of type IDictionary<string, Object>"
            }
          }
        }
      },
      "example_uses": [
        "Create a new interaction for a meeting that happened today.",
        "Log a phone call with a partner, associating it with specific contacts.",
        "Record an email exchange, linking it to a Gmail thread ID."
      ],
      "when_to_use": "Use this endpoint to log a new interaction event, such as a meeting, call, or email, from the Gmail Add-on, associating it with relevant contacts, partners, or users."
    },
    {
      "name": "UpdateInteraction",
      "url": "api/gmail-addon/interactions",
      "method": "PUT",
      "description": "Updates an existing interaction record. Requires the interaction's ID and allows modification of its details.",
      "parameters": {
        "model": {
          "type": "object",
          "required": true,
          "description": "Update interaction request payload.",
          "properties": {
            "Id": {
              "type": "integer",
              "required": true,
              "description": "Property of type int"
            },
            "Type": {
              "type": "string",
              "required": true,
              "description": "Property of type InteractionType"
            },
            "Date": {
              "type": "string",
              "required": true,
              "description": "Property of type DateTime"
            },
            "Description": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "EmailAddresses": {
              "type": "array",
              "required": false,
              "description": "Property of type List<string>"
            },
            "PhoneNumbers": {
              "type": "array",
              "required": false,
              "description": "Property of type List<string>"
            },
            "ContactIds": {
              "type": "array",
              "required": false,
              "description": "Property of type List<int>"
            },
            "PartnerIds": {
              "type": "array",
              "required": false,
              "description": "Property of type List<int>"
            },
            "UserIds": {
              "type": "array",
              "required": false,
              "description": "Property of type List<int>"
            },
            "Location": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "Subject": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "OrganizationHierarchyIds": {
              "type": "array",
              "required": false,
              "description": "Property of type List<int>"
            },
            "GmailThreadId": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "GmailMessageId": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "Status": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "ConfirmDuplicateCreation": {
              "type": "boolean",
              "required": true,
              "description": "Property of type bool"
            },
            "Extensions": {
              "type": "object",
              "required": false,
              "description": "Property of type IDictionary<string, Object>"
            }
          }
        }
      },
      "example_uses": [
        "Update the description of an interaction with ID 123.",
        "Change the type of an interaction from 'Meeting' to 'Call'.",
        "Add more contacts to an existing interaction record."
      ],
      "when_to_use": "Use this endpoint to modify the details of an already created interaction record, identified by its unique ID."
    },
    {
      "name": "FindGmailInteraction",
      "url": "api/gmail-addon/interactions/find",
      "method": "POST",
      "description": "Finds an interaction record based on Gmail thread ID or message ID. This is useful for checking if an email or thread has already been logged as an interaction.",
      "parameters": {
        "model": {
          "type": "object",
          "required": true,
          "description": "Gmail interaction request payload.",
          "properties": {
            "GmailThreadId": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "GmailMessageId": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            }
          }
        }
      },
      "example_uses": [
        "Find an interaction associated with a specific Gmail thread ID.",
        "Check if a particular Gmail message has an existing interaction record.",
        "Retrieve interaction details using a Gmail message identifier."
      ],
      "when_to_use": "Use this endpoint to retrieve an interaction record that was previously created and linked to a specific Gmail thread or message, typically to avoid duplicate entries or retrieve context."
    },
    {
      "name": "FindRelatedRecords",
      "url": "api/gmail-addon/interactions/find-related-records",
      "method": "POST",
      "description": "Identifies existing records (contacts, partners) related to provided email addresses or partner IDs. This helps in linking new interactions to existing entities.",
      "parameters": {
        "input": {
          "type": "object",
          "required": true,
          "description": "Gmail related records request payload.",
          "properties": {
            "EmailAddresses": {
              "type": "array",
              "required": false,
              "description": "Property of type List<string>"
            },
            "partnerIds": {
              "type": "array",
              "required": false,
              "description": "Property of type List<int>"
            }
          }
        }
      },
      "example_uses": [
        "Find contacts associated with a list of email addresses.",
        "Identify partners linked to specific partner IDs.",
        "Discover existing records that match given email addresses and partner IDs."
      ],
      "when_to_use": "Use this endpoint to discover existing contacts or partners in the system that are related to a given set of email addresses or partner IDs, facilitating the association of new interactions with known entities."
    },
    {
      "name": "CreateRecordsFromEmails",
      "url": "api/gmail-addon/create-records",
      "method": "POST",
      "description": "Creates new records (e.g., contacts) from selected email information, potentially linking them to Gmail thread/message IDs. This streamlines the process of adding new entities discovered via email.",
      "parameters": {
        "request": {
          "type": "object",
          "required": true,
          "description": "Gmail create records request payload.",
          "properties": {
            "SelectedContacts": {
              "type": "array",
              "required": false,
              "description": "Property of type List<GmailSelectedEmailModel>",
              "items": {
                "type": "object",
                "properties": {
                  "EmailAddress": {
                    "type": "string",
                    "required": false,
                    "description": "Property of type string"
                  },
                  "PartnerName": {
                    "type": "string",
                    "required": false,
                    "description": "Property of type string"
                  },
                  "PartnerId": {
                    "type": "integer",
                    "required": false,
                    "description": "Property of type Nullable<int>"
                  },
                  "FirstName": {
                    "type": "string",
                    "required": false,
                    "description": "Property of type string"
                  },
                  "MiddleName": {
                    "type": "string",
                    "required": false,
                    "description": "Property of type string"
                  },
                  "LastName": {
                    "type": "string",
                    "required": false,
                    "description": "Property of type string"
                  }
                }
              }
            },
            "GmailThreadId": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            },
            "GmailMessageId": {
              "type": "string",
              "required": false,
              "description": "Property of type string"
            }
          }
        }
      },
      "example_uses": [
        "Create new contact records from email addresses found in a Gmail thread.",
        "Add a new partner and contact based on an email signature.",
        "Generate new records for selected email recipients, linking them to the current Gmail context."
      ],
      "when_to_use": "Use this endpoint to quickly create new contact or partner records directly from email information, such as email addresses and names, often in the context of a Gmail thread or message."
    }
  ]
}
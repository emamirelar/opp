        "create",
        "add",
        "new",
        "register"
      ],
      "description": "Creates a new saved filter.",
      "searchCapability": {
        "type": "none",
        "searchFields": [],
        "supportsPagination": false,
        "supportsSort": false
      },
      "parameters": {
        "request": {
          "type": "object",
          "required": true,
          "description": "Filter creation request",
          "default": null
        }
      },
      "exampleBody": {
        "Name": "My Opportunities",
        "Description": "Opportunities I am tracking",
        "EntityType": "Opportunity",
        "SearchCriteria": "{\"Stage\":\"Closing\",\"Probability\":\">75\"}",
        "SearchText": null,
        "IsAdvancedSearch": true,
        "OrderBy": "CloseDate",
        "Ascending": false
      },
      "exampleUrl": null,
      "requiredFields": [
        "IsAdvancedSearch"
      ],
      "example_uses": [

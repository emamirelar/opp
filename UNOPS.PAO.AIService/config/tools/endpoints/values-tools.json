      "url": "/api/values/users/paged",
      "method": "POST",
      "intent": [
        "list",
        "get",
        "search"
      ],
      "description": "Retrieves a paged list of users based on search criteria.",
      "searchCapability": {
        "type": "advanced",
        "searchFields": [
          "SearchTerm",
          "ActiveOnly",
          "SelectedUserIds"
        ],
        "supportsPagination": true,
        "supportsSort": false
      },
      "parameters": {
        "request": {
          "type": "object",
          "required": true,
          "description": "Request object for paged user retrieval.",
          "default": null
        }
      },
      "exampleBody": {
        "PageIndex": 1,
        "PageSize": 20,
        "SearchTerm": "John",
        "ActiveOnly": true,
        "SelectedUserIds": [
          1,
          2,
          3
        ]
      },
      "exampleUrl": "/api/values/users/paged",
      "requiredFields": [
        "PageIndex",
        "PageSize",
        "ActiveOnly"
      ],
      "example_uses": [
        "Get a paged list of users with search criteria.",
        "Find users by name and active status."
      ],
      "when_to_use": "When you need to retrieve a paged list of users with filtering and search options.",
      "scoring": {
        "searchBonus": 80,
        "intentMatch": 80,
        "complexity": "medium"
      }
    },

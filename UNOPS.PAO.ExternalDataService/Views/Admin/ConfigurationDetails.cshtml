        // Live Monitor Functions
        function selectForMonitoring(executionId) {
            // If this execution is already being monitored, just switch to the Live Monitor tab
            if (selectedExecutionId === executionId) {
                const monitorTab = document.getElementById('monitor-tab');
                const monitorTabInstance = new bootstrap.Tab(monitorTab);
                monitorTabInstance.show();
                showToast('Info', `Switched to Live Monitor for execution ${executionId}`, 'info');
                return;
            }
            
            // Stop previous monitoring if any
            if (monitoringTimer) {
                clearInterval(monitoringTimer);
                monitoringTimer = null;
            }
            
            // Set new selection
            selectedExecutionId = executionId;
            
            // Update UI to show selection
            document.querySelectorAll('.execution-card').forEach(card => {
                card.classList.remove('border-primary');
            });
            document.getElementById(`execution-${executionId}`)?.classList.add('border-primary');
            
            // Switch to Live Monitor tab
            const monitorTab = document.getElementById('monitor-tab');
            const monitorTabInstance = new bootstrap.Tab(monitorTab);
            monitorTabInstance.show();
            
            // Start monitoring
            startLiveMonitoring(executionId);
            
            // Refresh the executions list to update button states
            loadExecutions(true);
            
            showToast('Success', `Started monitoring execution ${executionId}`, 'success');
        }
        
        function startLiveMonitoring(executionId) {
            // Initial load
            updateLiveMonitor(executionId);
            
            // Set up periodic updates every 5 seconds
            monitoringTimer = setInterval(() => {
                updateLiveMonitor(executionId);
            }, 5000);
        }
        
        async function updateLiveMonitor(executionId) {
            try {
                // Fetch execution details
                const overviewResponse = await fetch(`/admin/execution/${executionId}`);
                const overviewData = await overviewResponse.json();
                
                // Fetch batch details
                const batchesResponse = await fetch(`/admin/api/execution/${executionId}/batches`);
                const batchesData = await batchesResponse.json();
                
                // Fetch error details
                const errorsResponse = await fetch(`/admin/api/execution/${executionId}/errors`);
                const errorsData = await errorsResponse.json();
                
                // Update Live Monitor UI
                displayLiveMonitor(overviewData, batchesData, errorsData);
                
                // Check if execution is still running
                const isStillRunning = overviewData.IsRunning || overviewData.isRunning || 
                                     overviewData.Status === 'Running' || overviewData.status === 'Running';
                
                if (!isStillRunning) {
                    // Execution completed, stop monitoring
                    clearInterval(monitoringTimer);
                    monitoringTimer = null;
                    showToast('Info', `Execution ${executionId} has completed. Monitoring stopped.`, 'info');
                    
                    // Refresh executions to update the list
                    loadExecutions(true);
                }
                
            } catch (error) {
                console.error('Error updating live monitor:', error);
                showToast('Error', 'Failed to update live monitor data', 'error');
            }
        }
        
        // Helper function to decode Unicode escape sequences in error messages
        function decodeUnicodeEscapes(text) {
            if (!text || typeof text !== 'string') return text;
            
            try {
                // Replace Unicode escape sequences like \u0022 with their actual characters
                return text.replace(/\\u([0-9a-fA-F]{4})/g, function (match, code) {
                    return String.fromCharCode(parseInt(code, 16));
                });
            } catch (e) {
                console.warn('Failed to decode Unicode escapes in text:', text, e);
                return text;
            }
        }

        // Helper function to escape HTML attribute values
        function escapeHtmlAttribute(text) {
            if (!text || typeof text !== 'string') return text;
            
            return text
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#x27;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }


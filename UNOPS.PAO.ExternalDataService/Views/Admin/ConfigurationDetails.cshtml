                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h6><i class="fas fa-exclamation-triangle me-2"></i>Recent Errors (Top 5)</h6>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Time</th>
                                                <th>Type</th>
                                                <th>Message</th>
                                                <th>Batch</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            ${errorsData.errors.slice(0, 5).map(error => `
                                                <tr>
                                                    <td><small>${new Date(error.OccurredAt || error.occurredAt).toLocaleString()}</small></td>
                                                    <td><span class="badge bg-danger">${error.ErrorType || error.errorType || 'Unknown'}</span></td>
                                                    <td>
                                                        <div style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" 
                                                             title="${escapeHtmlAttribute(decodeUnicodeEscapes(error.ErrorMessage || error.errorMessage || ''))}">
                                                            ${decodeUnicodeEscapes(error.ErrorMessage || error.errorMessage || 'No message')}
                                                        </div>
                                                    </td>
                                                    <td>${error.BatchNumber || error.batchNumber || 'N/A'}</td>
                                                </tr>
                                            `).join('')}
                                        </tbody>
                                    </table>
                                </div>
                                ${errorsData.errors.length > 5 ? '<small class="text-muted">Showing 5 most recent errors only</small>' : ''}
                            </div>
                        </div>
                    </div>
                </div>
                ` : ''}
            `;
        }
        
        function stopMonitoring() {
            if (monitoringTimer) {
                clearInterval(monitoringTimer);
                monitoringTimer = null;
            }
            
            selectedExecutionId = null;
            
            // Remove selection highlighting
            document.querySelectorAll('.execution-card').forEach(card => {
                card.classList.remove('border-primary');
            });
            
            // Reset Live Monitor tab
            document.getElementById('monitor-container').innerHTML = `
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    Select a running execution from the Executions tab to monitor real-time progress.
                </div>
            `;
            
            // Refresh executions to update button states
            loadExecutions(true);
            
            showToast('Info', 'Live monitoring stopped', 'info');
        }
    </script>
</body>
</html>

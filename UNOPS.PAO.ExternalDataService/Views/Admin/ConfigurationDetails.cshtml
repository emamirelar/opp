                case 'Processing': return 'bg-primary';
                case 'Skipped': return 'bg-secondary';
                default: return 'bg-light text-dark';
            }
        }

        // Load more executions
        function loadMoreExecutions() {
            loadExecutions(false);
        }

        // Handle execution form submission
        function handleExecuteSync(event) {
            // Form will submit and redirect - no need for timeout here since page redirects
            // Delay logic is handled in DOMContentLoaded when success message is present
        }

        // Auto-refresh functionality
        function startAutoRefresh() {
            if (autoRefreshEnabled) {
                countdownSeconds = 30;
                updateCountdown();
                countdownTimer = setInterval(updateCountdown, 1000);
            }
        }

        // Faster auto-refresh when executions are running
        function startFastAutoRefresh() {
            if (countdownTimer) {
                clearInterval(countdownTimer);
            }
            
            let fastRefreshCount = 0;
            const maxFastRefreshes = 10; // Fast refresh for first 10 cycles
            
            function fastRefreshCycle() {
                if (fastRefreshCount < maxFastRefreshes && autoRefreshEnabled) {
                    refreshData();
                    fastRefreshCount++;
                    setTimeout(fastRefreshCycle, 5000); // Refresh every 5 seconds
                } else {
                    // Return to normal auto-refresh
                    startAutoRefresh();
                }
            }
            
            fastRefreshCycle();
        }

        // Adaptive auto-refresh based on running executions
        function adaptiveAutoRefresh() {
            if (countdownTimer) {
                clearInterval(countdownTimer);
            }
            
            if (autoRefreshEnabled) {
                const interval = runningExecutions.size > 0 ? 10 : 30; // 10 seconds if running, 30 if not
                countdownSeconds = interval;
                updateCountdown();
                countdownTimer = setInterval(updateCountdown, 1000);
            }
        }

        function updateCountdown() {
            document.getElementById('countdown').textContent = countdownSeconds;
            
            if (countdownSeconds <= 0) {
                if (autoRefreshEnabled) {
                    refreshData();
                    const nextInterval = runningExecutions.size > 0 ? 10 : 30;
                    countdownSeconds = nextInterval;
                }
            } else {
                countdownSeconds--;
            }
        }

        function toggleAutoRefresh() {
            autoRefreshEnabled = !autoRefreshEnabled;
            const button = document.getElementById('auto-refresh-text');
            
            if (autoRefreshEnabled) {
                button.textContent = 'Pause Auto-Refresh';
                adaptiveAutoRefresh();
            } else {
                button.textContent = 'Resume Auto-Refresh';
                clearInterval(countdownTimer);
                document.getElementById('countdown').textContent = '∞';
            }
        }

        function refreshData() {
            loadExecutions(true);
        }

        // Cancel running executions
        function updateCancelButton() {
            const cancelBtn = document.getElementById('cancelBtn');
            if (runningExecutions.size > 0) {
                cancelBtn.style.display = 'inline-block';
            } else {
                cancelBtn.style.display = 'none';
            }
        }

        async function cancelRunningExecution() {
            if (runningExecutions.size === 0) {
                showToast('Warning', 'No running executions to cancel', 'warning');
                return;
            }

            const executionCount = runningExecutions.size;
            const message = executionCount === 1 
                ? `Cancel the running execution for ${configurationName}?`
                : `Cancel all ${executionCount} running executions for ${configurationName}?`;
            
            if (!confirm(`${message} This action cannot be undone.`)) {
                return;
            }

            try {
                const response = await fetch(`/admin/api/configuration/${encodeURIComponent(configurationName)}/cancel`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const result = await response.json();
                
                if (response.ok) {
                    showToast('Success', result.message, 'success');
                    refreshData();
                } else {
                    showToast('Error', result.error || 'Failed to cancel executions', 'error');
                }
            } catch (error) {
                console.error('Error cancelling executions:', error);
                showToast('Error', 'Failed to cancel executions', 'error');
            }
        }

        // Toast notifications
        function showToast(title, message, type = 'info') {
            const toastId = 'toast-' + Date.now();
            const bgClass = {
                'success': 'bg-success',
                'warning': 'bg-warning',
                'error': 'bg-danger',
                'info': 'bg-info'
            }[type] || 'bg-info';

            const toastHtml = `
                <div id="${toastId}" class="toast ${bgClass} text-white" role="alert">
                    <div class="toast-header ${bgClass} text-white border-0">
                        <strong class="me-auto">${title}</strong>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="toast-body">${message}</div>
                </div>
            `;

            document.getElementById('toast-container').insertAdjacentHTML('beforeend', toastHtml);
            
            const toastElement = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastElement, { delay: 5000 });
            toast.show();
            
            toastElement.addEventListener('hidden.bs.toast', function() {
                toastElement.remove();
            });
        }

        // Toggle batch primary keys display
        function toggleBatchPrimaryKeys(batchId) {
            const detailsRow = document.getElementById(`batch-details-${batchId}`);
            const icon = document.getElementById(`batch-icon-${batchId}`);
            
            if (detailsRow.style.display === 'none') {
                // Show the details row
                detailsRow.style.display = 'table-row';
                icon.className = 'fas fa-chevron-up';
            } else {
                // Hide the details row
                detailsRow.style.display = 'none';
                icon.className = 'fas fa-chevron-down';
            }
        }

        // Copy text to clipboard
        async function copyToClipboard(text) {
            try {
                await navigator.clipboard.writeText(text);
                showToast('Success', 'Primary keys copied to clipboard', 'success');
            } catch (error) {
                console.error('Error copying to clipboard:', error);
                showToast('Error', 'Failed to copy to clipboard', 'error');

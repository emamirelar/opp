{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=unops_pao_external_data;Username=postgres;Password=password;Port=5432;"
  },
  
  "ExternalDataService": {
    "ConfigurationPath": "./config",
    "Enabled": true,
    "CheckIntervalMinutes": 60,
    "AutoCreateTables": true,
    "TestMode": false,
    "LogLevel": "Information"
  },
  
  "BigQuery": {
    "ProjectId": "",
    "UseDefaultCredentials": true,
    "CredentialsPath": ""
  },
  
  "AdminApiKey": "your-secure-api-key-here",
  
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "UNOPS.PAO.ExternalDataService.Infrastructure.Utilities.SqlHelper": "Information",
        "UNOPS.PAO.ExternalDataService.Services.Sync.SyncLoggingService": "Information",
        "UNOPS.PAO.ExternalDataService.Services.Sync.SyncProcessor": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/external-data-service-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  
  "AllowedHosts": "*",
  
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "Development": {
    "IAPSimulation": {
      "Enabled": true,
      "SkipValidationInDevelopment": true,
      "UserEmail": "anushas@unops.org"
    }
  },
  "IAP": {
    "AutoProvisionUsers": true,
    "DefaultRole": "User",
    "RequireJwtVerification": false,
    "AllowHeaderFallback": true,
    "DomainRoles": {
      "unops.org": "Internal",
      "partner.com": "Partner",
      "example.com": "External"
    },
    "ExternalRoleMappings": {
      "admin": "Administrator",
      "internal": "Internal",
      "partner": "Partner",
      "external": "External"
    }
  }
}

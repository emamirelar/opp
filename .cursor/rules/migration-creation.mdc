    migrationBuilder.Sql(@"
        DO $$ 
        BEGIN 
            IF EXISTS (
                SELECT 1 
                FROM pg_indexes 
                WHERE schemaname = 'public' 
                AND tablename = 'Opportunities' 
                AND indexname = 'IX_Opportunities_StatusDate'

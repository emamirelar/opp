#### **2. Temporal and Fiscal Boundaries**

Finance and Grant systems are slave to the calendar. Most defects appear at the "junctions" of time.

**✅ Fiscal Year Rollover**:
- Attempt to post a procurement invoice on the **last second of the fiscal year** (23:59:59) vs. **first second of the new one**

**Example test cases**:
```csharp
[Fact]
public void PostInvoice_LastSecondOfFiscalYear_AssignedToCorrectYear()
{
    // Assume fiscal year ends June 30
    var lastSecondFY2024 = new DateTime(2024, 6, 30, 23, 59, 59);
    var firstSecondFY2025 = new DateTime(2024, 7, 1, 0, 0, 0);
    
    var invoice1 = new Invoice 
    { 
        Amount = 5000m,
        PostedDate = lastSecondFY2024
    };
    
    var invoice2 = new Invoice 
    { 
        Amount = 3000m,
        PostedDate = firstSecondFY2025
    };
    
    var result1 = _fiscalService.AssignFiscalYear(invoice1);
    var result2 = _fiscalService.AssignFiscalYear(invoice2);
    
    Assert.Equal(2024, result1.FiscalYear);
    Assert.Equal(2025, result2.FiscalYear);
}

[Fact]
public void CloseGrant_OnFiscalYearBoundary_HandlesCorrectly()
{
    var grant = new Grant 
    { 
        ExpirationDate = new DateTime(2024, 6, 30, 23, 59, 59),
        Status = GrantStatus.Active
    };
    
    // Attempt to close grant at fiscal year boundary
    var result = _grantService.CloseGrant(grant.Id, 
        closureDate: new DateTime(2024, 6, 30, 23, 59, 59));
    
    Assert.True(result.Success);
    Assert.Equal(GrantStatus.Closed, result.Grant.Status);
}
```

**✅ Leap Year Budgeting**:
- For interest-bearing accounts or grant durations, test calculations that **span February 29th**

**Example test cases**:
```csharp
[Theory]
[InlineData(2024, 2, 29, true)]   // 2024 is a leap year
[InlineData(2023, 2, 29, false)]  // 2023 is not
[InlineData(2000, 2, 29, true)]   // 2000 is (divisible by 400)
[InlineData(1900, 2, 29, false)]  // 1900 is not (divisible by 100 but not 400)
public void CalculateGrantDuration_LeapYearDate_ValidatesCorrectly(
    int year, int month, int day, bool shouldBeValid)
{
    if (shouldBeValid)
    {
        var startDate = new DateTime(year, month, day);
        var grant = new Grant 
        { 
            StartDate = startDate,
            DurationMonths = 12
        };
        
        var result = _grantService.CalculateEndDate(grant);
        
        Assert.NotNull(result);
    }
    else
    {
        // Should reject invalid leap year date
        Assert.Throws<ArgumentOutOfRangeException>(() => 
            new DateTime(year, month, day));
    }
}

[Fact]
public void CalculateInterest_SpansLeapYear_Accurate366DayCalculation()
{
    var account = new Account 
    { 
        Balance = 100000m,
        InterestRate = 0.05m, // 5% annual
        StartDate = new DateTime(2024, 1, 1),  // Leap year
        EndDate = new DateTime(2024, 12, 31)
    };
    
    var interest = _financialService.CalculateInterest(account);
    
    // Leap year has 366 days, not 365
    var expectedDaily = 100000m * 0.05m / 366m;
    var expectedTotal = expectedDaily * 366m;
    
    Assert.Equal(expectedTotal, interest, 2); // 2 decimal precision
}
```


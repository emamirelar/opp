    // Total = $5,000 (at daily limit)
    for (int i = 0; i < 5; i++)
    {
        var payment = new PaymentRequest 
        { 
            UserId = userId,
            Amount = singleTxnLimit,
            Date = DateTime.Today
        };
        
        var result = await _paymentService.ProcessAsync(payment);
        
        if (i < 5)
        {
            Assert.True(result.Success); // First 5 succeed
        }

#### **Complete Workflow Example**

**Step 1: Define PICT Model**:
```
# Models/opportunity-create.txt
Country: USA, Canada, UK, France, Germany
Sector: Education, Healthcare, Infrastructure, Technology
Currency: USD, CAD, GBP, EUR
FundingAmount: 10000, 50000, 100000, 500000, 1000000
Duration: 6, 12, 24, 36

# Constraints
IF [Country] = "USA" THEN [Currency] = "USD";
IF [Country] = "Canada" THEN [Currency] = "CAD";
IF [Country] = "UK" THEN [Currency] = "GBP";
IF [Country] IN {"France", "Germany"} THEN [Currency] = "EUR";
```

**Step 2: Generate Test Cases**:
```powershell
pict Models/opportunity-create.txt > TestData/opportunity-combinations.txt
```

**Step 3: Create C# Test Class**:
```csharp
[Collection("Combinatorial")]
public class OpportunityCombinatorialTests
{
    private readonly IOpportunityService _opportunityService;
    
    public OpportunityCombinatorialTests()
    {
        _opportunityService = TestSetup.CreateOpportunityService();
    }
    
    [Theory]
    [MemberData(nameof(GetPictTestCases))]
    public async Task CreateOpportunity_PairwiseCombinations_AllValid(
        string country,
        string sector,
        string currency,
        decimal fundingAmount,
        int duration)
    {
        var opportunity = new OpportunityRequest 
        { 
            Country = country,
            Sector = sector,
            Currency = currency,
            FundingAmount = fundingAmount,
            DurationMonths = duration
        };
        
        var result = await _opportunityService.CreateAsync(opportunity);
        
        // Should either succeed or return clear validation error
        Assert.True(result.Success || !string.IsNullOrEmpty(result.ErrorMessage));
        
        // If currency constraint violated, should fail
        if ((country == "USA" && currency != "USD") ||
            (country == "Canada" && currency != "CAD"))
        {
            Assert.False(result.Success);
        }
    }
    
    public static IEnumerable<object[]> GetPictTestCases()
    {
        var lines = File.ReadAllLines("TestData/opportunity-combinations.txt")
            .Skip(1); // Skip header
        
        foreach (var line in lines)
        {
            var values = line.Split('\t');
            yield return new object[] 
            { 
                values[0], // Country
                values[1], // Sector
                values[2], // Currency
                decimal.Parse(values[3]), // FundingAmount
                int.Parse(values[4]) // Duration
            };
        }
    }
}
```

**Step 4: Run Tests**:
```powershell
dotnet test --filter "Category=Combinatorial" --logger "trx;LogFileName=combinatorial-results.trx"
```


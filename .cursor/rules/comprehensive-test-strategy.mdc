            new() { FileName = "doc2.pdf" } // This one will fail
        }
    };
    
    // Second document upload fails
    _mockDocumentService.SetupSequence(s => s.UploadAsync(It.IsAny<DocumentRequest>()))
        .ReturnsAsync(new DocumentModel { Id = 1 }) // First succeeds
        .ThrowsAsync(new Exception("Upload failed")); // Second fails
    
    var exception = await Record.ExceptionAsync(
        () => _opportunityManager.CreateAsync(request));
    

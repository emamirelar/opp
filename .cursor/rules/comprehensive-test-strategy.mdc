**Testing Cascade State Clearing**:
```csharp
[Fact]
public async Task UpdateContact_ChangeCountry_ClearsDependentFields()
{
    // Create contact with USA/California
    var contact = await _contactService.CreateAsync(new ContactRequest 
    { 
        Country = "USA",
        State = "California",
        City = "Los Angeles"
    });
    
    // Change country to Canada (State should be cleared or rejected)
    var updateRequest = new UpdateContactRequest 
    { 
        Id = contact.Id,
        Country = "Canada",
        State = "California", // Still has old state!
        City = "Los Angeles"
    };
    
    var result = await _contactService.UpdateAsync(updateRequest);
    
    // Should either clear State/City or reject with validation error
    if (result.Success)
    {
        Assert.Null(result.Contact.State); // State cleared
        Assert.Null(result.Contact.City);  // City cleared
    }
    else
    {
        Assert.Contains("state", result.ErrorMessage, 
            StringComparison.OrdinalIgnoreCase);
    }
}
```

**Testing Race Condition in Cascading Dropdowns**:
```csharp
[Fact]
public async Task UpdateContact_RapidCountryChanges_HandlesGracefully()
{
    var contact = await CreateContactAsync();
    
    // Simulate rapid dropdown changes (user clicks Country dropdown multiple times)
    var task1 = _contactService.UpdateAsync(new UpdateContactRequest 
    { 
        Id = contact.Id,
        Country = "USA",
        State = "California"
    });
    
    var task2 = _contactService.UpdateAsync(new UpdateContactRequest 
    { 
        Id = contact.Id,
        Country = "Canada",
        State = "Ontario"
    });
    
    await Task.WhenAll(task1, task2);
    
    // Reload contact
    var finalContact = await _contactService.GetByIdAsync(contact.Id);
    
    // Should have consistent Country/State combination
    if (finalContact.Country == "USA")
    {
        Assert.Contains(finalContact.State, new[] { "California", "Texas", null });
    }
    else if (finalContact.Country == "Canada")
    {
        Assert.Contains(finalContact.State, new[] { "Ontario", "Quebec", null });
    }
}
```


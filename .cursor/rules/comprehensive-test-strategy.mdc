    };
    
    var sixthResult = await _paymentService.ProcessAsync(sixthPayment);
    
    Assert.False(sixthResult.Success);
    Assert.Contains("daily limit", sixthResult.ErrorMessage, 
        StringComparison.OrdinalIgnoreCase);
}

[Theory]
[InlineData(10, 101, 1000, 5000, false)]  // 10 × $101 = $1,010 (exceeds daily at 5th txn)
[InlineData(5, 999, 1000, 5000, true)]    // 5 × $999 = $4,995 (within both limits)
[InlineData(1, 1001, 1000, 5000, false)]  // $1,001 (exceeds single transaction limit)
public async Task EnforceMultiLevelLimits_SingleAndDaily_BothRespected(
    int transactionCount, decimal amountEach, 
    decimal singleLimit, decimal dailyLimit, bool shouldAllSucceed)
{
    var userId = 456;

    for (int i = 0; i < transactionCount; i++)
    {
        var payment = new PaymentRequest 
        { 
            UserId = userId,
            Amount = amountEach,
            Date = DateTime.Today
        };
        
        var result = await _paymentService.ProcessAsync(payment);
        
        if (result.Success) successCount++;
    }
    
    if (shouldAllSucceed)
    {
        Assert.Equal(transactionCount, successCount);
    }
    else
    {
        Assert.True(successCount < transactionCount);
    }
}

## 🔄 Component Transform Functions

### **Standard Transform Usage**

Use established ComponentUtilsService transforms for common types:

```typescript
// Boolean transforms
readonly disabled = input<boolean, boolean | null | undefined>(false, { 
  transform: ComponentUtilsService.createBooleanTransform(false) 
});

// String transforms
readonly label = input<string, string | null | undefined>('', {
  transform: ComponentUtilsService.createStringTransform('')
});

readonly tooltip = input<string | undefined, string | null | undefined>(undefined, {
  transform: ComponentUtilsService.createOptionalStringTransform()
});

// Number transforms
readonly maxLength = input<number | undefined, number | string | null | undefined>(undefined, {
  transform: ComponentUtilsService.createNumberTransform()
});

readonly tabIndex = input<number, number | string | null | undefined>(0, {
  transform: ComponentUtilsService.createNumberWithDefaultTransform(0)
});

// Array transforms
readonly options = input<SelectOption[]>([]), {
  transform: ComponentUtilsService.createArrayTransform<SelectOption>()
});
```



### **Custom Transform Creation**

For complex types, create custom transforms:

```typescript
// In component or service
static createInputTypeTransform(defaultValue: InputType = 'text') {
  return (value: InputType | null | undefined): InputType => {
    if (value == null) return defaultValue;
    const validTypes: InputType[] = ['text', 'email', 'password', 'number', 'tel', 'url', 'search', 'decimal'];
    return validTypes.includes(value) ? value : defaultValue;
  };
}

// Usage in component
readonly type = input<InputType, InputType | null | undefined>('text', {
  transform: createInputTypeTransform('text')
});
```


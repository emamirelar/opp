## 📋 User Feedback & Confirmation Patterns

### **Confirmation Dialogs**

**MANDATORY**: Use the feedback service for user confirmations, NOT browser `alert()`, `confirm()`, or `prompt()`.

```typescript
// ✅ CORRECT - Use feedback service
import { FeedbackDialogService } from '@/shared/services/feedback-dialog.service';

export class MyComponent {
  private readonly feedbackService = inject(FeedbackDialogService);
  
  handleDelete() {
    this.feedbackService.showConfirmDialog(
      {
        summary: 'Delete Item',
        detail: 'Are you sure you want to delete this item? This action cannot be undone.',
      },
      () => {
        // User confirmed - proceed with deletion
        this.deleteItem();
        
        // Show success feedback
        this.feedbackService.showSuccessToast({
          summary: 'Success',
          detail: 'Item deleted successfully'
        });
      }
    );
  }
  
  handleSave() {
    this.saveChanges().subscribe({
      next: () => {
        this.feedbackService.showSuccessToast({
          summary: 'Success',
          detail: 'Changes saved successfully'
        });
      }
      // Error handling done by global HTTP interceptor
    });
  }
}

// ❌ WRONG - Don't use browser dialogs
handleDelete() {
  if (confirm('Are you sure you want to delete this item?')) {
    this.deleteItem();
    alert('Item deleted successfully');
  }
}
```

### **Dialog Validation Pattern**

**MANDATORY**: For custom dialogs (p-dialog), follow this validation pattern:

1. **Do NOT disable submit button** - Let users click to trigger validation
2. **Show validation errors on click** - Use a signal flag to control error display
3. **Validate in confirm method** - Check all required fields when user clicks submit
4. **Clear validation on cancel/open** - Reset validation state when dialog opens or closes

```typescript
// ✅ CORRECT - Dialog validation pattern
export class MyComponent {
  // Dialog state
  showMyDialog = false;
  readonly showDialogValidationError = signal<boolean>(false);
  selectedValue: string | null = null;

  // Open dialog - reset validation
  openDialog(): void {
    this.selectedValue = null;
    this.showDialogValidationError.set(false);
    this.showMyDialog = true;
  }

  // Cancel dialog - reset state
  cancelDialog(): void {
    this.showMyDialog = false;
    this.selectedValue = null;
    this.showDialogValidationError.set(false);
  }

  // Confirm dialog - validate on click
  confirmDialog(): void {
    // Validate required fields
    if (!this.selectedValue) {
      this.showDialogValidationError.set(true);
      return;
    }

    // Proceed with action
    this.isProcessing.set(true);
    this.myService.doAction(this.selectedValue).subscribe({
      next: (response) => {
        this.isProcessing.set(false);
        this.showMyDialog = false;
        this.selectedValue = null;
        this.showDialogValidationError.set(false);
        this.feedbackService.showSuccessToast({
          summary: 'Success',
          detail: 'Action completed successfully'
        });
      }
    });
  }
}
```

```html
<!-- ✅ CORRECT - Dialog template with validation -->
<p-dialog
  header="{{ 'title.myDialog' | translate }}"
  [(visible)]="showMyDialog"
  [modal]="true"
  [style]="{ width: '35rem' }"
>
  <!-- Validation error message -->
  @if (showDialogValidationError()) {
    <p-message severity="error" icon="pi pi-info-circle" styleClass="mb-4 w-full">
      {{ 'message.validation.required' | translate }}
    </p-message>
  }

  <!-- Dialog content -->
  <div class="mb-6">
    <p-floatlabel variant="on">
      <p-select
        id="myField"
        [(ngModel)]="selectedValue"
        [options]="options()"
        optionLabel="name"
        optionValue="id"
        [filter]="true"
        class="w-full"
      />
      <label for="myField">{{ 'label.myField' | translate }} *</label>
    </p-floatlabel>
    @if (!selectedValue && showDialogValidationError()) {
      <p-message severity="error" variant="simple" styleClass="mt-2">
        {{ 'message.validation.myFieldRequired' | translate }}
      </p-message>
    }
  </div>

  <!-- Dialog footer -->
  <ng-template pTemplate="footer">
    <p-button
      [label]="'button.cancel' | translate"
      severity="secondary"
      (onClick)="cancelDialog()"
      [disabled]="isProcessing()"
    />
    <p-button
      [label]="'button.confirm' | translate"
      severity="primary"
      (onClick)="confirmDialog()"
      [loading]="isProcessing()"
    />
  </ng-template>
</p-dialog>

<!-- ❌ WRONG - Button disabled initially -->
<p-button
  [label]="'button.confirm' | translate"
  (onClick)="confirmDialog()"
  [disabled]="!selectedValue"  <!-- ❌ Don't disable based on validation -->
/>
```

**Key Points:**
- ✅ Submit button is always enabled (except during processing)
- ✅ Validation triggered on button click, not real-time
- ✅ Validation errors shown only after user attempts to submit
- ✅ Validation state cleared when dialog opens/closes
- ✅ Use appropriate dialog size for content (not too large)
- ✅ Add virtual scrolling for long dropdowns


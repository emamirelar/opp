## 🚀 Modern Angular 19 Signals Architecture

### **Input Signals Pattern**

**MANDATORY**: Use `input()` function with transforms, NOT `@Input()` decorators.

```typescript
// ✅ CORRECT Pattern
readonly variant = input<ButtonVariant, ButtonVariant | null | undefined>('primary', {
  transform: ComponentUtilsService.createButtonVariantTransform('primary')
});

readonly disabled = input<boolean, boolean | null | undefined>(false, { 
  transform: ComponentUtilsService.createBooleanTransform(false) 
});

readonly title = input<string | undefined, string | null | undefined>(undefined, {
  transform: ComponentUtilsService.createOptionalStringTransform()
});

readonly maxLength = input<number | undefined, number | string | null | undefined>(undefined, {
  transform: ComponentUtilsService.createNumberTransform()
});

// Custom transform for complex validation
readonly type = input<InputType, InputType | null | undefined>('text', {
  transform: (value: InputType | null | undefined): InputType => {
    if (value == null) return 'text';
    const validTypes: InputType[] = ['text', 'email', 'password', 'number'];
    return validTypes.includes(value) ? value : 'text';
  }
});

// ❌ INCORRECT - Don't use decorators
@Input() variant: string = 'primary';
```

### **Output Signals Pattern**

**MANDATORY**: Use `output()` function, NOT `@Output()` decorators.

```typescript
// ✅ CORRECT Pattern
readonly buttonClick = output<MouseEvent>();
readonly selectionChange = output<SelectChangeEvent>();
readonly dismiss = output<void>();

// Event with complex payload
readonly actionClick = output<{ action: BannerActionConfig; event: Event }>();

// ❌ INCORRECT - Don't use decorators
@Output() buttonClick = new EventEmitter<MouseEvent>();
```

### **Computed Signals Pattern**

Use `computed()` for derived values:

```typescript
readonly effectiveInputType = computed(() => {
  if (this.type() === 'password' && this.showPasswordToggle() && this.passwordVisible) {
    return 'text';
  }
  return this.type();
});

readonly inputClasses = computed(() => {
  return this.formFieldService.getInputClasses({
    hasPrefix: !!(this.prefixIcon() || this.prefixText()),
    hasSuffix: !!(this.suffixIcon() || this.suffixText()),
    size: this.size(),
    disabled: this.disabled()
  });
});
```


## 🏗️ Interface & Type Management

### **1. Create Union Types for Input Signals**

Define union types in appropriate interface files:
- **Shared/Common types**: `UNOPS.PAO.ClientApp/src/app/shared/interfaces/` (e.g., `feedback.ts`, `document.interface.ts`)
- **Feature-specific types**: 
  - Partnerships: `UNOPS.PAO.ClientApp/src/app/features/partnerships/[subfeature]/models/`
  - Admin: `UNOPS.PAO.ClientApp/src/app/features/admin/[subfeature]/models/`
  - AI: `UNOPS.PAO.ClientApp/src/app/features/ai/models/`
  - Shared features: `UNOPS.PAO.ClientApp/src/app/features/shared/models/`

```typescript
// ✅ CORRECT Pattern
export type ButtonVariant = 'primary' | 'secondary' | 'tertiary' | 'danger';
export type ComponentSize = 'small' | 'normal' | 'large';
export type ValidationState = 'none' | 'error' | 'warning' | 'success';
export type EntityStatus = 'active' | 'inactive' | 'pending' | 'archived';
export type InteractionType = 'meeting' | 'email' | 'call' | 'visit' | 'other';
```

### **2. Decompose Complex Interfaces**

Break complex interfaces into constituent parts and provide both individual and complex interface input approaches:

```typescript
// ✅ CORRECT Pattern - Decomposed interfaces with dual input approach
export interface CardMedia {
  src: string;
  alt: string;
  type?: MediaType;
  aspectRatio?: MediaAspectRatio;
  position?: MediaPosition;
  size?: MediaSize;
  radius?: MediaRadius;
  maintainAspectRatio?: boolean;
  maxHeight?: number;
  maxWidth?: number;
  loading?: MediaLoadingStrategy;
}

export type MediaType = 'image' | 'video';
export type MediaAspectRatio = '16:9' | '4:3' | '1:1' | 'auto';
export type MediaPosition = 'top' | 'left' | 'right' | 'bottom' | 'background';
export type MediaSize = 'small' | 'medium' | 'large' | 'full' | 'auto';

// Individual input signals for each property (decomposed approach)
readonly mediaSrc = input<string | undefined>();
readonly mediaAlt = input<string | undefined>();
readonly mediaType = input<MediaType, MediaType | null | undefined>('image', {
  transform: (value: MediaType | null | undefined) => {
    const validTypes: MediaType[] = ['image', 'video'];
    return value && validTypes.includes(value) ? value : 'image';
  }
});
readonly mediaAspectRatio = input<MediaAspectRatio, MediaAspectRatio | null | undefined>('16:9', {
  transform: (value: MediaAspectRatio | null | undefined) => {
    const validRatios: MediaAspectRatio[] = ['16:9', '4:3', '1:1', 'auto'];
    return value && validRatios.includes(value) ? value : '16:9';
  }
});
readonly mediaPosition = input<MediaPosition, MediaPosition | null | undefined>('top', {
  transform: (value: MediaPosition | null | undefined) => {
    const validPositions: MediaPosition[] = ['top', 'left', 'right', 'bottom', 'background'];
    return value && validPositions.includes(value) ? value : 'top';
  }
});

// Single complex interface input signal (object approach)
readonly media = input<CardMedia | undefined>();

// Computed signal that resolves between individual properties and complex object
readonly resolvedMedia = computed<CardMedia | undefined>(() => {
  // Check if individual media properties are provided
  const hasSrc = !!this.mediaSrc();
  const hasAlt = !!this.mediaAlt();
  
  // If individual properties are provided, use them (takes precedence)
  if (hasSrc && hasAlt) {
    return {
      src: this.mediaSrc()!,
      alt: this.mediaAlt()!,
      type: this.mediaType(),
      aspectRatio: this.mediaAspectRatio(),
      position: this.mediaPosition(),
      // ... other individual properties
    };
  }
  
  // Otherwise, use the single media object if provided
  return this.media();
});

// ❌ INCORRECT - Complex nested interface without decomposition
export interface ComplexBannerInterface {
  actions: {
    label: string;
    icon?: string;
    action: () => void;
    disabled?: boolean;
    variant?: 'primary' | 'secondary' | 'tertiary' | 'danger';
  }[];
  actionVariant?: 'primary' | 'secondary' | 'tertiary' | 'danger';
}
```

### **3. Maintain input signals that receive primitive types**

The intent is to only create interfaces for union types (for enums and choices) and any object interfaces needed. Use primitives for input signals that just receive a primitive.


### **4. Component-Specific Transform Functions**

Create custom transforms in `ComponentUtilsService` for complex types:

```typescript
// In ComponentUtilsService
static createButtonVariantTransform(defaultValue: ButtonVariant = 'primary') {
  return (value: ButtonVariant | null | undefined): ButtonVariant => {
    if (value == null) return defaultValue;
    const validVariants: ButtonVariant[] = ['primary', 'secondary', 'tertiary', 'danger'];
    return validVariants.includes(value) ? value : defaultValue;
  };
}

// Use in component
readonly variant = input<ButtonVariant, ButtonVariant | null | undefined>('primary', {
  transform: ComponentUtilsService.createButtonVariantTransform('primary')
});
```


# Environment Selection
FLASK_ENV=development  # Options: development, production, testing

# Development Database Configuration (Local)
DB_USER=postgres
DB_PASS=your-dev-password
DB_NAME=your-dev-db
CLOUD_SQL_CONNECTION_NAME=your-dev-connection-name

# Production Database Configuration
PROD_DB_USER=postgres
PROD_DB_PASS=your-prod-password
PROD_DB_NAME=your-prod-db
PROD_CLOUD_SQL_CONNECTION_NAME=your-prod-connection-name

# Testing Database Configuration
TEST_DB_USER=postgres
TEST_DB_PASS=your-test-password
TEST_DB_NAME=your-test-db
TEST_CLOUD_SQL_CONNECTION_NAME=your-test-connection-name

# Flask Configuration
FLASK_DEBUG=True  # Will be overridden by environment config
FLASK_PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# AI Service
AI_SERVICE_URL=http://localhost:5000
AI_MODEL_LOCATION=us-central1
AI_MODEL_NAME=gemini-pro

# Flask
FLASK_APP=app 
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Enable XML Documentation Generation for Tools.json Automation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn> <!-- Suppress missing XML comment warnings -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="Google.Cloud.PubSub.V1" Version="3.24.0" />
    <PackageReference Include="Google.Cloud.Speech.V1" Version="3.8.0" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.11.0" />
    <PackageReference Include="Google.Cloud.TextToSpeech.V1" Version="3.10.0" />
    <PackageReference Include="Google.Cloud.Vision.V1" Version="3.7.0" />
    <PackageReference Include="Humanizer" Version="2.14.1" />
    <PackageReference Include="Lamar.Microsoft.DependencyInjection" Version="14.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>9.*-*</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UNOPS.PAO.UNOPSDataAccess\UNOPS.PAO.UNOPSDataAccess.csproj" />
    <ProjectReference Include="..\UNOPS.PAO.UNOPSIdentity\UNOPS.PAO.UNOPSIdentity.csproj" />
    <ProjectReference Include="..\UNOPS.PAO.Utilities\UNOPS.PAO.Utilities.csproj" />
    <ProjectReference Include="..\UNOPS.PAO.Business\UNOPS.PAO.Business.csproj" />
    <ProjectReference Include="..\UNOPS.PAO.DataAccess\UNOPS.PAO.DataAccess.csproj" />
    <ProjectReference Include="..\UNOPS.PAO.Domain\UNOPS.PAO.Domain.csproj" />
    <ProjectReference Include="..\UNOPS.PAO.GoogleServices\UNOPS.PAO.GoogleServices.csproj" />
    <ProjectReference Include="..\UNOPS.PAO.Models\UNOPS.PAO.Models.csproj" />
    <ProjectReference Include="..\UNOPS.PAO.UNOPSBusiness\UNOPS.PAO.UNOPSBusiness.csproj" />
  </ItemGroup>

  <!-- 🚀 AUTOMATED API METADATA GENERATION -->
  <Target Name="GenerateApiMetadata" AfterTargets="Build;Publish">
    <Message Text="🔍 Generating API metadata for AI agent..." Importance="high" />
    
    <!-- Configuration Properties (can be overridden) -->
    <PropertyGroup>
      <GoogleCloudProject Condition="'$(GoogleCloudProject)' == ''">$(GOOGLE_CLOUD_PROJECT)</GoogleCloudProject>
      <GoogleCloudLocation Condition="'$(GoogleCloudLocation)' == ''">$(GOOGLE_CLOUD_LOCATION)</GoogleCloudLocation>
      <GoogleCloudLocation Condition="'$(GoogleCloudLocation)' == ''">us-central1</GoogleCloudLocation>
      <PAOEnvironment Condition="'$(PAOEnvironment)' == ''">$(PAO_ENVIRONMENT)</PAOEnvironment>
      <PAOEnvironment Condition="'$(PAOEnvironment)' == ''">dev</PAOEnvironment>
    </PropertyGroup>
    
    <!-- Build the ReflectionExtractor tool first -->
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\ToolsJsonGenerator\ReflectionExtractor\ReflectionExtractor.csproj" 
             Targets="Build" 
             Properties="Configuration=Release" />
    
    <!-- Step 1: Run the .NET reflection extraction -->
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\ToolsJsonGenerator\ReflectionExtractor&quot; -- --dll &quot;$(OutputPath)$(AssemblyName).dll&quot; --xml &quot;$(OutputPath)$(AssemblyName).xml&quot; --output &quot;$(MSBuildProjectDirectory)\..\UNOPS.PAO.AIService\api-metadata.json&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    
    <Message Text="[SUCCESS] Step 1: API metadata extracted to UNOPS.PAO.AIService\api-metadata.json" Importance="high" />
    
    <!-- Step 2: Run Python LLM generation with automatic environment detection -->
    <Message Text="[AI] Step 2: Generating tools.json with Vertex AI..." Importance="high" />
    <Message Text="   Environment: $(PAOEnvironment)" Importance="normal" />
    <Message Text="   Project: $(GoogleCloudProject)" Importance="normal" Condition="'$(GoogleCloudProject)' != ''" />
    <Message Text="   Location: $(GoogleCloudLocation)" Importance="normal" />
    
    <!-- Build Python command with all parameters -->
    <PropertyGroup>
      <LLMTimeout Condition="'$(LLMTimeout)' == ''">120</LLMTimeout>
      <SkipLLM Condition="'$(SkipLLM)' == ''">false</SkipLLM>
      <PythonCommand>python &quot;$(MSBuildProjectDirectory)\..\ToolsJsonGenerator\llm_generator.py&quot; --input &quot;$(MSBuildProjectDirectory)\..\UNOPS.PAO.AIService\api-metadata.json&quot; --output &quot;$(MSBuildProjectDirectory)\..\UNOPS.PAO.AIService\config\backend_tools.json&quot; --timeout $(LLMTimeout)</PythonCommand>
      <PythonCommand Condition="'$(PAOEnvironment)' != ''">$(PythonCommand) --environment &quot;$(PAOEnvironment)&quot;</PythonCommand>
      <PythonCommand Condition="'$(GoogleCloudProject)' != ''">$(PythonCommand) --project &quot;$(GoogleCloudProject)&quot;</PythonCommand>
      <PythonCommand Condition="'$(GoogleCloudLocation)' != ''">$(PythonCommand) --location &quot;$(GoogleCloudLocation)&quot;</PythonCommand>
      <PythonCommand Condition="'$(SkipLLM)' == 'true'">$(PythonCommand) --skip-llm</PythonCommand>
    </PropertyGroup>
    
    <Message Text="   [RUN] Running: $(PythonCommand)" Importance="normal" />
    
    <Exec Command="$(PythonCommand)"
          WorkingDirectory="$(MSBuildProjectDirectory)" 
          ContinueOnError="true" 
          IgnoreExitCode="true" />
    
    <Message Text="" Importance="high" />
    <Message Text="[INFO] If Step 2 failed, here are some solutions:" Importance="high" />
    <Message Text="   [TIP] Test environment config: python ToolsJsonGenerator\test_environment.py" Importance="high" />
    <Message Text="   [TIP] Set environment: -p:PAOEnvironment=dev (or staging, production)" Importance="high" />
    <Message Text="   [TIP] Manual override: -p:GoogleCloudProject=your-project -p:GoogleCloudLocation=us-central1" Importance="high" />
    <Message Text="   [TIP] Auth setup: gcloud auth application-default login" Importance="high" />
    <Message Text="   [TIP] For faster builds: -p:SkipLLM=true (uses basic template)" Importance="high" />
    <Message Text="   [TIP] Adjust timeout: -p:LLMTimeout=600 (default: 120 seconds)" Importance="high" />
    <Message Text="" Importance="high" />
  </Target>

</Project>

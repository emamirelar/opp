{
  "ConnectionStrings": {
    "DefaultConnection": "your-production-monitoring-connection-string",
    "ApplicationConnection": "your-production-app-connection-string"
  },
  
  "ExternalDataService": {
    "ConfigurationPath": "./config",
    "Enabled": true,
    "CheckIntervalMinutes": 60,
    "AutoCreateTables": true,
    "TestMode": false,
    "LogLevel": "Information"
  },
  
  "BigQuery": {
    "ProjectId": "your-project-prod",
    "UseDefaultCredentials": true,
    "CredentialsPath": ""
  },
  
  "AdminApiKey": "your-production-api-key",
  
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GoogleCloudLogging",
        "Args": {
          "projectId": "your-project-prod",
          "logName": "external-data-service",
          "labels": {
            "service": "external-data-service",
            "environment": "production"
          }
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
